{
  "name": "gov-ai-client",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync:styles": "esbuild src/styles/i-ai-design-system.css --minify --outfile=public/i-ai-design-system.min.css --allow-overwrite",
    "sync:scripts": "esbuild src/scripts/i-ai-design-system.js --minify --format=esm --outfile=public/i-ai-design-system.min.js --allow-overwrite",
    "sync:assets": "npm run sync:styles && npm run sync:scripts",
    "dev": "npm run sync:assets && astro dev",
    "build": "npm run sync:assets && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npx eslint --fix"
  },
  "dependencies": {
    "@astrojs/node": "^9.2.1",
    "@i-dot-ai-npm/utilities": "^1.0.0",
    "@sentry/astro": "^9.33.0",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.16.6",
    "dotenv": "^16.4.7",
    "govuk-frontend": "^6.4.0",
    "jose": "^6.0.10",
    "sass": "^1.102.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@eslint/json": "^0.12.0",
    "@eslint/markdown": "^6.6.0",
    "@stylistic/eslint-plugin": "^5.1.0",
    "@types/govuk-frontend": "^5.11.0",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.35.1"
  },
  "overrides": {
    "mdast-util-to-hast@<=13.2.1": "13.2.1",
    "h3@<=1.15.5": "1.15.5",
    "devalue@<=5.6.2": "5.6.2"
  }
}
