---
import {
  Table,
  TableHead,
  TableRow,
  TableHeader,
  TableBody,
  TableCell,
  Link,
  Checkboxes,
  CheckboxItem,
  CheckboxInput,
  CheckboxLabel,
  ButtonGroup,
  Button,
} from "@i-dot-ai-npm/component-library-astro";
---

<Table summary subtle>
  <TableHead>
    <TableRow>
      <TableHeader>Select</TableHeader>
      <TableHeader>Title</TableHeader>
      <TableHeader>Date</TableHeader>
      <TableHeader>Actions</TableHeader>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell>
        <Checkboxes small subtle>
          <CheckboxItem>
            <CheckboxInput id="item-1" name="item-1" value="item-1" />
            <CheckboxLabel>
              <span class="govuk-visually-hidden">Select item 1</span>
            </CheckboxLabel>
          </CheckboxItem>
        </Checkboxes>
      </TableCell>
      <TableCell stretch>
        <Link href="#" noVisitedState>Item 1</Link>
      </TableCell>
      <TableCell noWrap small>12 Aug, 11:45</TableCell>
      <TableCell noWrap>
        <ButtonGroup>
          <Button small tertiary href="#">Rename</Button>
          <Button small tertiary href="#">Export</Button>
        </ButtonGroup>
      </TableCell>
    </TableRow>
    <TableRow>
      <TableCell>
        <Checkboxes small subtle>
          <CheckboxItem>
            <CheckboxInput id="item-2" name="item-2" value="item-2" />
            <CheckboxLabel>
              <span class="govuk-visually-hidden">Select item 2</span>
            </CheckboxLabel>
          </CheckboxItem>
        </Checkboxes>
      </TableCell>
      <TableCell stretch>
        <Link href="#" noVisitedState>Item 2</Link>
      </TableCell>
      <TableCell noWrap small>11 Aug, 11:45</TableCell>
      <TableCell noWrap>
        <ButtonGroup>
          <Button small tertiary href="#">Rename</Button>
          <Button small tertiary href="#">Export</Button>
        </ButtonGroup>
      </TableCell>
    </TableRow>
  </TableBody>
</Table>
