---
import FormGroup from "@i-dot-ai-npm/component-library-astro/form-group/form-group.astro";
import InputLabel from "@i-dot-ai-npm/component-library-astro/input-label/input-label.astro";
import Hint from "@i-dot-ai-npm/component-library-astro/hint/hint.astro";
import Input from "@i-dot-ai-npm/component-library-astro/input/input.astro";
---

<FormGroup>
  <InputLabel for="input-hint">National Insurance number</InputLabel>
  <Hint id="input-hint-hint">
    It’s on your National Insurance card, benefit letter, payslip or P60.
  </Hint>
  <Input
    id="input-hint"
    name="input-hint"
    aria-describedby="input-hint-hint"
  />
</FormGroup>