---
import FormGroup from "@i-dot-ai-npm/component-library-astro/form-group/form-group.astro";
import InputLabel from "@i-dot-ai-npm/component-library-astro/input-label/input-label.astro";
import Textarea from "@i-dot-ai-npm/component-library-astro/textarea/textarea.astro";
---

<FormGroup class="govuk-form-group--error">
  <InputLabel for="textarea-error">Can you provide more detail?</InputLabel>
  <Textarea id="textarea-error" name="textarea-error" rows="5" error />
</FormGroup>