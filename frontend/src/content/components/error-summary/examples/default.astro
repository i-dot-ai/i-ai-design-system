---
import ErrorSummary from "@i-dot-ai-npm/component-library-astro/error-summary/error-summary.astro";
import ErrorSummaryTitle from "@i-dot-ai-npm/component-library-astro/error-summary/error-summary-title.astro";
import ErrorSummaryBody from "@i-dot-ai-npm/component-library-astro/error-summary/error-summary-body.astro";
import ErrorSummaryList from "@i-dot-ai-npm/component-library-astro/error-summary/error-summary-list.astro";
import ErrorSummaryItem from "@i-dot-ai-npm/component-library-astro/error-summary/error-summary-item.astro";
---

<ErrorSummary>
  <ErrorSummaryTitle>There is a problem</ErrorSummaryTitle>
  <ErrorSummaryBody>
    <ErrorSummaryList>
      <ErrorSummaryItem href="#ex-1">
        The date your passport was issued must be in the past
      </ErrorSummaryItem>
      <ErrorSummaryItem href="#ex-2">
        Enter a postcode, like AA1 1AA
      </ErrorSummaryItem>
    </ErrorSummaryList>
  </ErrorSummaryBody>
</ErrorSummary>