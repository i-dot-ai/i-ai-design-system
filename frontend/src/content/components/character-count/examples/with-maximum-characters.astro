---
import FormGroup from "@i-dot-ai-npm/component-library-astro/form-group/form-group.astro";
import InputLabel from "@i-dot-ai-npm/component-library-astro/input-label/input-label.astro";
import CharacterCount from "@i-dot-ai-npm/component-library-astro/character-count/character-count.astro";
import CharacterCountMessage from "@i-dot-ai-npm/component-library-astro/character-count/character-count-message.astro";
---

<FormGroup
  class="govuk-character-count"
  data-module="govuk-character-count"
  data-maxlength={10}
>
  <InputLabel for="more-detail">Can you provide more detail?</InputLabel>
  <CharacterCount
    id="more-detail"
    name="more-detail"
    rows="5"
    aria-describedby="more-detail-info"
  />
  <CharacterCountMessage id="more-detail-info">
    You can enter up to 10 characters
  </CharacterCountMessage>
</FormGroup>