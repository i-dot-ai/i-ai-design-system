---
import FormGroup from "@i-dot-ai-npm/component-library-astro/form-group/form-group.astro";
import InputLabel from "@i-dot-ai-npm/component-library-astro/input-label/input-label.astro";
import Hint from "@i-dot-ai-npm/component-library-astro/hint/hint.astro";
import Fieldset from "@i-dot-ai-npm/component-library-astro/fieldset/fieldset.astro";
import FieldsetLegend from "@i-dot-ai-npm/component-library-astro/fieldset/fieldset-legend.astro";
import DateInput from "@i-dot-ai-npm/component-library-astro/date-input/date-input.astro";
import DateInputItem from "@i-dot-ai-npm/component-library-astro/date-input/date-input-item.astro";
import DateInputField from "@i-dot-ai-npm/component-library-astro/date-input/date-input-field.astro";
---

<FormGroup>
  <Fieldset role="group" aria-describedby="dob-hint">
    <FieldsetLegend>What is your date of birth?</FieldsetLegend>
    <Hint id="dob-hint">For example, 31 3 1980</Hint>
    <DateInput id="dob">
      <DateInputItem>
        <FormGroup>
          <InputLabel for="dob-day" class="govuk-date-input__label">Day</InputLabel>
          <DateInputField id="dob-day" name="day" width={2} />
        </FormGroup>
      </DateInputItem>
      <DateInputItem>
        <FormGroup>
          <InputLabel for="dob-month" class="govuk-date-input__label">Month</InputLabel>
          <DateInputField id="dob-month" name="month" width={2} />
        </FormGroup>
      </DateInputItem>
      <DateInputItem>
        <FormGroup>
          <InputLabel for="dob-year" class="govuk-date-input__label">Year</InputLabel>
          <DateInputField id="dob-year" name="year" width={4} />
        </FormGroup>
      </DateInputItem>
    </DateInput>
  </Fieldset>
</FormGroup>