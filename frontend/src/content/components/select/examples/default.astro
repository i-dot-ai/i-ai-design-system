---
import FormGroup from "@i-dot-ai-npm/component-library-astro/form-group/form-group.astro";
import InputLabel from "@i-dot-ai-npm/component-library-astro/input-label/input-label.astro";
import Select from "@i-dot-ai-npm/component-library-astro/select/select.astro";
import SelectOption from "@i-dot-ai-npm/component-library-astro/select/select-option.astro";
---

<FormGroup inline>
  <InputLabel for="select-2">Label text goes here</InputLabel>
  <Select id="select-2" name="select-2">
    <SelectOption value="1">GOV.UK frontend option 1</SelectOption>
    <SelectOption value="2" selected>GOV.UK frontend option 2</SelectOption>
    <SelectOption value="3" disabled>GOV.UK frontend option 3</SelectOption>
  </Select>
</FormGroup>