---
import CardGroup from "@i-dot-ai-npm/component-library-astro/card/card-group.astro";
import Card from "@i-dot-ai-npm/component-library-astro/card/card.astro";
import CardHeading from "@i-dot-ai-npm/component-library-astro/card/card-heading.astro";
import CardLink from "@i-dot-ai-npm/component-library-astro/card/card-link.astro";
import CardContent from "@i-dot-ai-npm/component-library-astro/card/card-content.astro";
---

<CardGroup>
  <Card>
    <CardHeading>
      <h3 class="govuk-heading-m">
        <CardLink href="#">Dashboard</CardLink>
      </h3>
    </CardHeading>
    <CardContent>See the state of everything in one place.</CardContent>
  </Card>
  <Card>
    <CardHeading>
      <h3 class="govuk-heading-m">
        <CardLink href="#">Reports</CardLink>
      </h3>
    </CardHeading>
    <CardContent>Generate and download service reports.</CardContent>
  </Card>
  <Card>
    <CardHeading>
      <h3 class="govuk-heading-m">
        <CardLink href="#">Settings</CardLink>
      </h3>
    </CardHeading>
    <CardContent>Manage your account and preferences.</CardContent>
  </Card>
</CardGroup>
