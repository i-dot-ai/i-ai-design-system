---
/*
 * Example — renders one component example on a docs page:
 *   1. a live preview, rendered from the example's .html file, and
 *   2. the "Show code" Astro/HTML tabs, from the .astro/.html files.
 *
 * Example files are referenced by relative path from the entry's index.mdx
 * (e.g. "./examples/default.astro"). The `component` prop is the slug of the
 * entry folder, used to resolve those paths unambiguously. Works for both the
 * `components` and `styles` collections via the `collection` prop.
 */
import { Code } from "astro:components";
import { Tabs, TabsList, Tab, TabPanel, Details, DetailsSummary, DetailsText } from "@i-dot-ai-npm/component-library-astro";
import CopyButton from "@components/docs/copy-button.astro";

interface Props {
    astro?: string;
    html?: string;
    react?: string;
    svelte?: string;
    solid?: string;
    /** Entry folder slug (from the page), used to resolve example paths. */
    component: string;
    /** Content collection the entry lives in. Defaults to "components". */
    collection?: "components" | "styles" | "decisions" | "get-started" | "patterns";
    variant?: "default" | "inverse";
}

const {
    astro,
    html,
    react,
    svelte,
    solid,
    component,
    collection = "components",
    variant = "default",
} = Astro.props;

const files = import.meta.glob(
    "/src/content/{components,styles,decisions,get-started,patterns}/**/examples/*.{astro,html,svelte,tsx}",
    { query: "?raw", import: "default", eager: true },
) as Record<string, string>;

function resolve(relPath?: string): string | undefined {
    if (!relPath) return undefined;
    const tail = relPath.replace(/^\.\//, "");
    const suffix = `/${collection}/${component}/${tail}`;
    const hit = Object.entries(files).find(([key]) => key.endsWith(suffix));
    return hit?.[1];
}

const astroCode = resolve(astro);
const htmlCode = resolve(html);
const reactCode = resolve(react);
const svelteCode = resolve(svelte);
const solidCode = resolve(solid);

const containerClass =
    variant === "inverse"
        ? "component-container--inverse"
        : "component-container";

const base = (astro || html || react || svelte || solid || "example")
    .replace(/^\.\//, "")
    .replace(/\//g, "-")
    .replace(/\.(astro|html|svelte|tsx)$/, "")
    .replace(/\.(react|solid)$/, "");

type TabLang = "html" | "astro" | "react" | "svelte" | "solid";
const tabs: Array<{ lang: TabLang; code: string; label: string; shiki: string }> =
    [];
// Order: HTML, Astro, React, Svelte, Solid
if (htmlCode) tabs.push({ lang: "html", code: htmlCode, label: "HTML", shiki: "html" });
if (astroCode) tabs.push({ lang: "astro", code: astroCode, label: "Astro", shiki: "astro" });
if (reactCode) tabs.push({ lang: "react", code: reactCode, label: "React", shiki: "tsx" });
if (svelteCode) tabs.push({ lang: "svelte", code: svelteCode, label: "Svelte", shiki: "svelte" });
if (solidCode) tabs.push({ lang: "solid", code: solidCode, label: "Solid", shiki: "tsx" });
---

<div class={containerClass} set:html={htmlCode ?? ""} />

{
    tabs.length > 0 && (
        <Details>
            <DetailsSummary>Show code</DetailsSummary>
            <DetailsText>
                <Tabs>
                    <TabsList>
                        {tabs.map((t, i) => (
                            <Tab href={`#${base}-${t.lang}`} selected={i === 0}>
                                {t.label}
                            </Tab>
                        ))}
                    </TabsList>
                    {tabs.map((t, i) => (
                        <TabPanel id={`${base}-${t.lang}`} hidden={i !== 0}>
                            <div class="app-code-example">
                                <CopyButton code={t.code} />
                                <div class="code-example">
                                    <Code code={t.code} lang={t.shiki} theme="github-light" />
                                </div>
                            </div>
                        </TabPanel>
                    ))}
                </Tabs>
            </DetailsText>
        </Details>
    )
}
