---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    inline?: boolean;
    small?: boolean;
}

const { inline = false, small = false, class: className, ...rest } = Astro.props;

const modifiers = [
    inline ? "govuk-radios--inline" : "",
    small ? "govuk-radios--small" : "",
]
    .filter(Boolean)
    .join(" ");
---

<div
    class={`govuk-radios${modifiers ? ` ${modifiers}` : ""}${className ? ` ${className}` : ""}`}
    data-module="govuk-radios"
    {...rest}
>
    <slot />
</div>
