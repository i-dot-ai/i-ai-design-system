---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    hidden?: boolean;
}

const { hidden = false, class: className, ...rest } = Astro.props;
---

<div
    class={`govuk-tabs__panel${hidden ? " govuk-tabs__panel--hidden" : ""}${className ? ` ${className}` : ""}`}
    {...rest}
>
    <slot />
</div>
