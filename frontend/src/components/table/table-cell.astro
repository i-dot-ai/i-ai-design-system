---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"td"> {
    numeric?: boolean;
}

const { numeric = false, class: className, ...rest } = Astro.props;
---

<td
    class={`govuk-table__cell${numeric ? " govuk-table__cell--numeric" : ""}${className ? ` ${className}` : ""}`}
    {...rest}
>
    <slot />
</td>
