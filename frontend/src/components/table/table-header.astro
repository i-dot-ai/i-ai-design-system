---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"th"> {
    numeric?: boolean;
    scope?: "col" | "row";
}

const { numeric = false, scope = "col", class: className, ...rest } = Astro.props;
---

<th
    class={`govuk-table__header${numeric ? " govuk-table__header--numeric" : ""}${className ? ` ${className}` : ""}`}
    scope={scope}
    {...rest}
>
    <slot />
</th>
