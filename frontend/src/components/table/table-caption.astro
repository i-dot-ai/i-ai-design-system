---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"caption"> {
    size?: "small" | "medium" | "large" | "xl";
}

const { size, class: className, ...rest } = Astro.props;

const sizeClass = size
    ? {
          small: "govuk-table__caption--s",
          medium: "govuk-table__caption--m",
          large: "govuk-table__caption--l",
          xl: "govuk-table__caption--xl",
      }[size]
    : "";
---

<caption
    class={`govuk-table__caption${sizeClass ? ` ${sizeClass}` : ""}${className ? ` ${className}` : ""}`}
    {...rest}
>
    <slot />
</caption>
