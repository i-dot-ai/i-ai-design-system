---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"textarea"> {
    error?: boolean;
    subtle?: boolean;
}

const { error = false, subtle = false, class: className, ...rest } = Astro.props;
---

<textarea
    class={`govuk-textarea${error ? " govuk-textarea--error" : ""}${subtle ? " govuk-textarea--subtle" : ""}${className ? ` ${className}` : ""}`}
    {...rest}></textarea>
