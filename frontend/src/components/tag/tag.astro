---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
    colour?:
        | "grey"
        | "green"
        | "turquoise"
        | "blue"
        | "light-blue"
        | "purple"
        | "pink"
        | "red"
        | "orange"
        | "yellow";
}

const { colour, class: className, ...rest } = Astro.props;
---

<strong
    class={`govuk-tag${colour ? ` govuk-tag--${colour}` : ""}${className ? ` ${className}` : ""}`}
    {...rest}
>
    <slot />
</strong>
