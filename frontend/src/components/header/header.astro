---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    homepageLink?: string;
    backgroundColor?: string;
}

const {
    homepageLink = "/",
    backgroundColor,
    class: className,
    ...rest
} = Astro.props;
---

<div
    class={`govuk-generic-header${className ? ` ${className}` : ""}`}
    style={backgroundColor
        ? `background-color: ${backgroundColor};`
        : undefined}
    {...rest}
>
    <div class="govuk-generic-header__container govuk-width-container">
        <div class="govuk-!-padding-bottom-2 govuk-!-padding-top-2">
            <slot name="logo" />
            <a href={homepageLink} class="govuk-generic-header__homepage-link">
                <slot />
            </a>
        </div>
    </div>
</div>
