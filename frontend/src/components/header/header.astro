---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    href?: string;
    backgroundColour?: string;
}

const { href = "/", backgroundColour, class: className, ...rest } = Astro.props;
---

<div
    class={`govuk-generic-header${className ? ` ${className}` : ""}`}
    style={backgroundColour
        ? `background-color: ${backgroundColour};`
        : undefined}
    {...rest}
>
    <div class="govuk-generic-header__container govuk-width-container">
        <div class="govuk-generic-header__logo">
            <a href={href} class="govuk-generic-header__homepage-link">
                <slot />
            </a>
        </div>
    </div>
</div>
