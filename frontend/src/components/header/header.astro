---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    logoSrc?: string;
    logoAlt?: string;
    homepageLink?: string;
    backgroundColor?: string;
}

const {
    logoSrc = "/header-logo.svg",
    logoAlt = "i.AI",
    homepageLink = "/",
    backgroundColor,
    class: className,
    ...rest
} = Astro.props;
---

<div
    class={`govuk-generic-header${className ? ` ${className}` : ""}`}
    style={backgroundColor
        ? `background-color: ${backgroundColor};`
        : undefined}
    {...rest}
>
    <div class="govuk-generic-header__container govuk-width-container">
        <div class="govuk-!-padding-bottom-2">
            <img
                src={logoSrc}
                alt={logoAlt}
                class="govuk-generic-header__logo"
            />
            <a href={homepageLink} class="govuk-generic-header__homepage-link">
                <slot />
            </a>
        </div>
    </div>
</div>
