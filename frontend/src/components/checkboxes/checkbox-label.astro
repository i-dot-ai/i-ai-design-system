---
import type { HTMLAttributes } from "astro/types";
import InputLabel from "@components/input-label/input-label.astro";
interface Props extends HTMLAttributes<"label"> {}

const { class: className, ...rest } = Astro.props;
---

<InputLabel
    class={`govuk-checkboxes__label${className ? ` ${className}` : ""}`}
    {...rest}
>
    <slot />
</InputLabel>
