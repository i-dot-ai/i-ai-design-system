---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    secondary?: boolean;
}

const { class: className, secondary = false, ...rest } = Astro.props;
---

<div
    class={`iai-card${secondary ? " iai-card--secondary" : ""}${className ? ` ${className}` : ""}`}
    {...rest}
>
    <slot />
</div>
