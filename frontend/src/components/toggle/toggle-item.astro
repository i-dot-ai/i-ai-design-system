---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...rest } = Astro.props;
---

<div
    class={`iai-toggle__item${className ? ` ${className}` : ""}`}
    data-module="govuk-toggle"
    {...rest}
>
    <slot />
</div>
