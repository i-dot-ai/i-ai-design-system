---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"input"> {}

const { class: className, ...rest } = Astro.props;
---

<div class="iai-toggle">
    <input
        class={`iai-toggle__input${className ? ` ${className}` : ""}`}
        type="checkbox"
        {...rest}
    />
</div>
