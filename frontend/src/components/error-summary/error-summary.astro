---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...rest } = Astro.props;
---

<div
    class={`govuk-error-summary${className ? ` ${className}` : ""}`}
    data-module="govuk-error-summary"
    {...rest}
>
    <div role="alert">
        <slot />
    </div>
</div>
