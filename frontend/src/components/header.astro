---
interface Props {
    productName: string;
}

const { productName = "Product name" } = Astro.props;
---

<div class="govuk-generic-header">
    <div class="govuk-generic-header__container govuk-width-container">
        <div class="govuk-!-padding-bottom-2">
            <img
                src="/header-logo.svg"
                alt="i.AI"
                class="govuk-generic-header__logo"
            /><a href="/" class="govuk-generic-header__homepage-link"
                >{productName}</a
            >
        </div>
    </div>
</div>
