---
import "../styles/govuk.scss";
import "../styles/i-ai-design-system.css";
import "../styles/global.css";

import ServiceNavigation from "@components/service-navigation/service-navigation.astro";
import ServiceNavigationItem from "@components/service-navigation/service-navigation-item.astro";
import Header from "@components/header/header.astro";
const pathName = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>i.AI Design System</title>
	</head>
	<body class="govuk-template__body">
		<script is:inline>
			document.body.className +=
				" js-enabled" +
				("noModule" in HTMLScriptElement.prototype
					? " govuk-frontend-supported"
					: "");
		</script>
		<a href="#main-content" class="govuk-skip-link">Skip to main content</a>
		<Header>
			<svg
				slot="logo"
				width="28"
				class="govuk-generic-header__logo"
				height="30"
				viewBox="0 0 28 30"
				fill="currentColor"
				xmlns="http://www.w3.org/2000/svg"
			>
				<circle cx="13.5549" cy="4.21349" r="4.21349"></circle>
				<circle cx="13.5549" cy="25.7865" r="4.21349"></circle>
				<circle cx="22.8963" cy="9.6068" r="4.21349"></circle>
				<circle cx="4.2135" cy="20.3932" r="4.21349"></circle>
				<circle cx="22.8963" cy="20.3932" r="4.21349"></circle>
				<circle cx="4.21351" cy="9.60674" r="4.21349"></circle>
			</svg>
			i.AI Design Kit
		</Header>
		<ServiceNavigation inverse={pathName === "/"}>
			<ServiceNavigationItem href="/get-started">
				Get started
			</ServiceNavigationItem>
			<ServiceNavigationItem href="/components">
				Components
			</ServiceNavigationItem>
			<ServiceNavigationItem href="/patterns">
				Patterns
			</ServiceNavigationItem>
			<ServiceNavigationItem href="/decisions-record">
				Decisions record
			</ServiceNavigationItem>
		</ServiceNavigation>
		<main id="main-content" role="main">
			<slot />
		</main>
		<script>
			import { initAll } from "govuk-frontend";
			import { initAllIAIDesignSystem } from "../scripts/i-ai-design-system.js";
			initAll();
			initAllIAIDesignSystem();
		</script>
	</body>
</html>
