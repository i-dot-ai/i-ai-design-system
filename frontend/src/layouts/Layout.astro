---
import "../styles/govuk.scss";
import "../styles/global.css";
import "../styles/i-ai-design-system.css";

import ServiceNavigation from "@components/service-navigation.astro";
import Header from "@components/header.astro";
const pathName = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>i.AI Design System</title>
	</head>
	<body class="govuk-template__body">
		<script is:inline>
			document.body.className +=
				" js-enabled" +
				("noModule" in HTMLScriptElement.prototype
					? " govuk-frontend-supported"
					: "");
		</script>
		<a href="#main-content" class="govuk-skip-link">Skip to main content</a>
		<Header productName="Design System" />
		<ServiceNavigation
			class={pathName === "/" ? "govuk-service-navigation--inverse" : ""}
			isWebVersion={true}
			items={[
				{
					text: "Get started",
					href: "/get-started",
				},
				{
					text: "Styles",
					href: "/styles",
				},
				{
					text: "Components",
					href: "/components",
				},
				{
					text: "Patterns",
					href: "/patterns",
				},
				{
					text: "Principles",
					href: "/principles",
				},
				{
					text: "Community",
					href: "/community",
				},
			]}
		/>
		<main id="main-content" role="main">
			<slot />
		</main>
		<script>
			import { initAll } from "govuk-frontend";
			initAll();
		</script>
	</body>
</html>
