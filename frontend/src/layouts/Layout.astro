---
import '../styles/global.css';
import '../styles/govuk.scss';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>i.AI App</title>
	</head>
	<body class="govuk-template__body">
		<script is:inline>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>
		<main>
			<slot />
		</main>
		<script>
			import { initAll } from 'govuk-frontend';
			initAll();
		</script>
	</body>
</html>
