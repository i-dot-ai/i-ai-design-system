---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import Breadcrumbs from "@i-dot-ai-npm/component-library-astro/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@i-dot-ai-npm/component-library-astro/breadcrumbs/breadcrumb-item.astro";
import { getCollection } from "astro:content";

const currentPath = Astro.url.pathname;

// Fixed order the groups are shown in.
const GROUP_ORDER = [
    "Branding",
    "Design",
    "Technical",
    "Approach",
] as const;

const entries = await getCollection("decisions");
const decisionsRecordList = entries
    .map((entry) => ({
        number: entry.data.number ?? 0,
        text: `${String(entry.data.number).padStart(3, "0")} - ${entry.data.title}`,
        href: `/decisions-record/${entry.id}`,
        group: entry.data.group,
    }))
    .sort((a, b) => a.number - b.number);

// Records grouped under their `group` heading, in the fixed group order.
const groupedDecisionsRecordList = GROUP_ORDER.map((group) => ({
    group,
    records: decisionsRecordList.filter((record) => record.group === group),
})).filter((g) => g.records.length > 0);

// Any record without a group (e.g. the further-context record) is listed
// after the grouped ones.
const ungroupedDecisionsRecordList = decisionsRecordList.filter(
    (record) => record.group === undefined,
);
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-third">
                <SideNav>
                    <SideNavList>
                        {
                            groupedDecisionsRecordList.map((group) => (
                                <>
                                    <li class="side-nav__group-heading govuk-!-font-size-16 govuk-!-font-weight-bold">
                                        {group.group}
                                    </li>
                                    {group.records.map((decision) => (
                                        <SideNavItem
                                            text={decision.text}
                                            href={decision.href}
                                        />
                                    ))}
                                </>
                            ))
                        }
                        {
                            ungroupedDecisionsRecordList.map((decision) => (
                                <SideNavItem
                                    text={decision.text}
                                    href={decision.href}
                                />
                            ))
                        }
                    </SideNavList>
                </SideNav>
            </div>
            <div class="govuk-grid-column-two-thirds">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/decisions-record" && (
                            <BreadcrumbItem href="/decisions-record">
                                Decisions record
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
