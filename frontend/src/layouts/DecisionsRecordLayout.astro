---
import Layout from "@layouts/Layout.astro";
import {
    Breadcrumbs,
    BreadcrumbItem,
    ContentsPanel,
    ContentsPanelList,
    ContentsPanelItem,
    ContentsPanelListHeading,
} from "@i-dot-ai-npm/component-library-astro";
import { getCollection } from "astro:content";

const currentPath = Astro.url.pathname;

// Fixed order the groups are shown in.
const GROUP_ORDER = ["Branding", "Design", "Technical", "Approach"] as const;

const entries = await getCollection("decisions");
const decisionsRecordList = entries
    .map((entry) => ({
        number: entry.data.number ?? 0,
        text: `${String(entry.data.number).padStart(3, "0")} - ${entry.data.title}`,
        href: `/decisions-record/${entry.id}`,
        group: entry.data.group,
    }))
    .sort((a, b) => a.number - b.number);

// Records grouped under their `group` heading, in the fixed group order.
const groupedDecisionsRecordList = GROUP_ORDER.map((group) => ({
    group,
    records: decisionsRecordList.filter((record) => record.group === group),
})).filter((g) => g.records.length > 0);
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-third">
                <ContentsPanel>
                    {
                        groupedDecisionsRecordList.map((group) => (
                            <>
                                <ContentsPanelListHeading>
                                    {group.group}
                                </ContentsPanelListHeading>
                                <ContentsPanelList>
                                    {group.records.map((decision) => (
                                        <ContentsPanelItem
                                            href={decision.href}
                                            current={currentPath.includes(
                                                decision.href,
                                            )}
                                        >
                                            {decision.text}
                                        </ContentsPanelItem>
                                    ))}
                                </ContentsPanelList>
                            </>
                        ))
                    }
                </ContentsPanel>
            </div>
            <div class="govuk-grid-column-two-thirds">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/decisions-record" && (
                            <BreadcrumbItem href="/decisions-record">
                                Decisions record
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
