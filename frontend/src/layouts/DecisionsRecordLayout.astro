---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import Breadcrumbs from "@components/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@components/breadcrumbs/breadcrumb-item.astro";
import { getCollection } from "astro:content";

const currentPath = Astro.url.pathname;

const entries = await getCollection("decisions");
const decisionsRecordList = entries
    .map((entry) => ({
        number: entry.data.number ?? 0,
        text:
            typeof entry.data.number === "number"
                ? `${String(entry.data.number).padStart(3, "0")} - ${entry.data.title}`
                : entry.data.title,
        href: `/decisions-record/${entry.id}`,
    }))
    .sort((a, b) => a.number - b.number);
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-third">
                <SideNav>
                    <SideNavList>
                        {
                            decisionsRecordList.map((decision) => (
                                <SideNavItem
                                    text={decision.text}
                                    href={decision.href}
                                />
                            ))
                        }
                    </SideNavList>
                </SideNav>
            </div>
            <div class="govuk-grid-column-two-thirds">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/decisions-record" && (
                            <BreadcrumbItem href="/decisions-record">
                                Decisions record
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
