---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import Breadcrumbs from "@components/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@components/breadcrumbs/breadcrumb-item.astro";

const currentPath = Astro.url.pathname;

const decisionsRecordList = [
    {
        text: "001 - Adapt the GOV.UK Design System",
        href: "/decisions-record/adapt-govuk-design-system",
    },
    {
        text: "002 - Buttons",
        href: "/decisions-record/buttons",
    },
    {
        text: "003 - Subtle components",
        href: "/decisions-record/subtle-components",
    },
    {
        text: "004 - Side Navigation",
        href: "/decisions-record/side-navigation",
    },
];
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-third">
                <SideNav>
                    <SideNavList>
                        {
                            decisionsRecordList.map((decision) => (
                                <SideNavItem
                                    text={decision.text}
                                    href={decision.href}
                                />
                            ))
                        }
                    </SideNavList>
                </SideNav>
            </div>
            <div class="govuk-grid-column-two-thirds">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/decisions-record" && (
                            <BreadcrumbItem href="/decisions-record">
                                Decisions record
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
