---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import Breadcrumbs from "@i-dot-ai-npm/component-library-astro/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@i-dot-ai-npm/component-library-astro/breadcrumbs/breadcrumb-item.astro";

import SideNavTitle from "@components/side-nav/side-nav-title.astro";

const currentPath = Astro.url.pathname;

const structurePages = [
    {
        text: "Public facing landing page",
        href: "/styles/public-facing-landing-page",
    },
    {
        text: "Main application structure",
        href: "/styles/main-application-structure",
    },
];

const brandingPages = [
    {
        text: "Branding guidelines",
        href: "/styles/branding",
    },
];

const visualPages = [
    {
        text: "Colour palette",
        href: "/styles/colour-palette",
    },
    {
        text: "Chart colours",
        href: "/styles/chart-colours",
    },
];
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <SideNav>
                    <SideNavTitle>Branding</SideNavTitle>
                    <SideNavList>
                        {
                            brandingPages.map((page) => (
                                <SideNavItem
                                    text={page.text}
                                    href={page.href}
                                />
                            ))
                        }
                    </SideNavList>
                    <SideNavTitle>Structure</SideNavTitle>
                    <SideNavList>
                        {
                            structurePages.map((page) => (
                                <SideNavItem
                                    text={page.text}
                                    href={page.href}
                                />
                            ))
                        }
                    </SideNavList>
                    <SideNavTitle>Colour</SideNavTitle>
                    <SideNavList>
                        {
                            visualPages.map((page) => (
                                <SideNavItem
                                    text={page.text}
                                    href={page.href}
                                />
                            ))
                        }
                    </SideNavList>
                </SideNav>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/styles" && (
                            <BreadcrumbItem href="/styles">
                                Styles
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
