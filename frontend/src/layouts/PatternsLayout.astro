---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import SideNavTitle from "@components/side-nav/side-nav-title.astro";
import { Breadcrumbs, BreadcrumbItem } from "@i-dot-ai-npm/component-library-astro";
import { getCollection } from "astro:content";

const currentPath = Astro.url.pathname;

// The in-folder landing page (patterns/index.mdx) is rendered by
// patterns/index.astro, not as a pattern in the side nav.
const entries = await getCollection("patterns", ({ id }) => id !== "index");

// Patterns are grouped under the pain point they solve. Each pain point becomes
// a SideNavTitle heading, with its patterns listed beneath.
const UNGROUPED = "Other";
const groupsMap = new Map<string, { text: string; href: string }[]>();
for (const entry of entries) {
    const painPoint = entry.data.painPoint ?? UNGROUPED;
    const list = groupsMap.get(painPoint) ?? [];
    list.push({
        text: entry.data.name ?? entry.id,
        href: `/patterns/${entry.id}`,
    });
    groupsMap.set(painPoint, list);
}

const groups = [...groupsMap.entries()]
    .map(([painPoint, patterns]) => ({
        painPoint,
        patterns: patterns.sort((a, b) => a.text.localeCompare(b.text)),
    }))
    .sort((a, b) => a.painPoint.localeCompare(b.painPoint));
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <SideNav>
                    {
                        groups.map((group) => (
                            <>
                                <SideNavTitle>{group.painPoint}</SideNavTitle>
                                <SideNavList>
                                    {group.patterns.map((pattern) => (
                                        <SideNavItem
                                            text={pattern.text}
                                            href={pattern.href}
                                        />
                                    ))}
                                </SideNavList>
                            </>
                        ))
                    }
                </SideNav>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/patterns" && (
                            <BreadcrumbItem href="/patterns">
                                Patterns
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
