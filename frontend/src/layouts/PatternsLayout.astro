---
import Layout from "@layouts/Layout.astro";
import {
    Breadcrumbs,
    BreadcrumbItem,
    ContentsPanel,
    ContentsPanelList,
    ContentsPanelItem,
    ContentsPanelListHeading,
} from "@i-dot-ai-npm/component-library-astro";
import { getCollection } from "astro:content";

const currentPath = Astro.url.pathname;

// The in-folder landing page (patterns/index.mdx) is rendered by
// patterns/index.astro, not as a pattern in the side nav.
const entries = await getCollection("patterns", ({ id }) => id !== "index");

// Patterns are grouped under the pain point they solve. Each pain point becomes
// a SideNavTitle heading, with its patterns listed beneath.
const UNGROUPED = "Other";
const groupsMap = new Map<
    string,
    { text: string; href: string; order?: number }[]
>();
for (const entry of entries) {
    const painPoint = entry.data.painPoint ?? UNGROUPED;
    const list = groupsMap.get(painPoint) ?? [];
    list.push({
        text: entry.data.name ?? entry.id,
        href: `/patterns/${entry.id}`,
        order: entry.data.order,
    });
    groupsMap.set(painPoint, list);
}

// Within a pain point, sort by `order` (lower first). Patterns without an
// order fall to the end, then sort alphabetically by name.
function byOrderThenName(
    a: { text: string; order?: number },
    b: { text: string; order?: number },
) {
    const ao = a.order ?? Infinity;
    const bo = b.order ?? Infinity;
    if (ao !== bo) return ao - bo;
    return a.text.localeCompare(b.text);
}

const groups = [...groupsMap.entries()]
    .map(([painPoint, patterns]) => ({
        painPoint,
        patterns: patterns.sort(byOrderThenName),
    }))
    .sort((a, b) => a.painPoint.localeCompare(b.painPoint));
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <ContentsPanel>
                    {
                        groups.map((group) => (
                            <>
                                <ContentsPanelListHeading>
                                    {group.painPoint}
                                </ContentsPanelListHeading>
                                <ContentsPanelList>
                                    {group.patterns.map((pattern) => (
                                        <ContentsPanelItem
                                            href={pattern.href}
                                            current={currentPath.includes(
                                                pattern.href,
                                            )}
                                        >
                                            {pattern.text}
                                        </ContentsPanelItem>
                                    ))}
                                </ContentsPanelList>
                            </>
                        ))
                    }
                </ContentsPanel>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/patterns" && (
                            <BreadcrumbItem href="/patterns">
                                Patterns
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
