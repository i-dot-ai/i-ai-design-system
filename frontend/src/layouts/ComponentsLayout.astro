---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import Breadcrumbs from "@i-dot-ai-npm/component-library-astro/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@i-dot-ai-npm/component-library-astro/breadcrumbs/breadcrumb-item.astro";
import { getCollection } from "astro:content";

const currentPath = Astro.url.pathname;

// The in-folder landing page (components/index.mdx) is rendered by
// components/index.astro, not as a component in the side nav.
const entries = await getCollection(
    "components",
    ({ id }) => id !== "index",
);
const componentList = entries
    .map((entry) => ({
        text: entry.data.name ?? entry.id,
        href: `/components/${entry.id}`,
    }))
    .sort((a, b) => a.text.localeCompare(b.text));
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <SideNav>
                    <SideNavList>
                        {
                            componentList.map((component) => (
                                <SideNavItem
                                    text={component.text}
                                    href={component.href}
                                />
                            ))
                        }
                    </SideNavList>
                </SideNav>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/components" && (
                            <BreadcrumbItem href="/components">
                                Components
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
