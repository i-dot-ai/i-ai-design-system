---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import { Breadcrumbs, BreadcrumbItem } from "@i-dot-ai-npm/component-library-astro";
import SideNavTitle from "@components/side-nav/side-nav-title.astro";

const currentPath = Astro.url.pathname;

const useTheKitPages = [
    {
        text: "Prototype with the Design Kit",
        href: "/get-started/prototype-with-the-kit",
    },
    {
        text: "Start a new product or experiment",
        href: "/get-started/start-a-new-product-or-experiment",
    },
    {
        text: "Apply the Design Kit to an existing product",
        href: "/get-started/apply-the-kit-to-an-existing-product",
    },

];
const collaboratePages = [
    {
        text: "Add to the Design kit",
        href: "/get-started/kit-forum",
    },
]
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <SideNav>
                    <SideNavTitle>Set up guides</SideNavTitle>
                    <SideNavList>
                        {
                            useTheKitPages.map((category) => (
                                <SideNavItem
                                text={category.text}
                                href={category.href}
                                />
                            ))
                        }
                    </SideNavList>
                    <SideNavTitle>Contribution guides</SideNavTitle>
                    <SideNavList>
                        {
                            collaboratePages.map((category) => (
                                <SideNavItem
                                text={category.text}
                                href={category.href}
                                />
                            ))
                        }
                    </SideNavList>
                </SideNav>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/get-started" && (
                            <BreadcrumbItem href="/get-started">
                                Get started
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
