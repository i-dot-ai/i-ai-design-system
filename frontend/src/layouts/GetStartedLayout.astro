---
import Layout from "@layouts/Layout.astro";
import SideNav from "@components/side-nav/side-nav.astro";
import SideNavItem from "@components/side-nav/side-nav-item.astro";
import SideNavList from "@components/side-nav/side-nav-list.astro";
import Breadcrumbs from "@components/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@components/breadcrumbs/breadcrumb-item.astro";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    onThisPage?: Heading[];
}

const { onThisPage = [] } = Astro.props;
const hasOnThisPage = onThisPage.length > 0;

const currentPath = Astro.url.pathname;

const getStartedCategories = [
    {
        text: "Start a new product or experiment",
        href: "/get-started/journey-1-start-something-new",
    },
    {
        text: "Use a component in a product",
        href: "/get-started/journey-2-add-to-an-existing-product",
    },
    {
        text: "Apply the kit to an existing product",
        href: "/get-started/journey-3-apply-the-kit-to-an-existing-product",
    },
    {
        text: "Contribute to the Design kit",
        href: "/get-started/kit-forum",
    },
];
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container--wide">
        <div class="govuk-grid-row">
            <div class={hasOnThisPage ? "govuk-grid-column-one-quarter" : "govuk-grid-column-one-third"}>
                <SideNav>
                    <SideNavList>
                        {
                            getStartedCategories.map((category) => (
                                <SideNavItem
                                    text={category.text}
                                    href={category.href}
                                />
                            ))
                        }
                    </SideNavList>
                </SideNav>
            </div>
            <div class={hasOnThisPage ? "govuk-grid-column-one-half" : "govuk-grid-column-two-thirds"}>
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/get-started" && (
                            <BreadcrumbItem href="/get-started">
                                Get started
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
            {
                hasOnThisPage && (
                    <div class="govuk-grid-column-one-quarter">
                        <nav class="on-this-page" aria-label="On this page">
                            <p class="on-this-page__title">On this page</p>
                            <ul class="on-this-page__list">
                                {onThisPage.map((heading) => (
                                    <li class="on-this-page__item">
                                        <a
                                            class="on-this-page__link"
                                            href={`#${heading.slug}`}
                                        >
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    </div>
                )
            }
        </div>
    </div>
</Layout>
