---
import Layout from "@layouts/Layout.astro";
import {
    Breadcrumbs,
    BreadcrumbItem,
    ContentsPanel,
    ContentsPanelList,
    ContentsPanelItem,
    ContentsPanelListHeading,
} from "@i-dot-ai-npm/component-library-astro";

const currentPath = Astro.url.pathname;

const useTheKitPages = [
    {
        text: "Prototype with the Design Kit",
        href: "/get-started/prototype-with-the-kit",
    },
    {
        text: "Start a new product or experiment",
        href: "/get-started/start-a-new-product-or-experiment",
    },
    {
        text: "Apply the Design Kit to an existing product",
        href: "/get-started/apply-the-kit-to-an-existing-product",
    },
];
const collaboratePages = [
    {
        text: "Add to the Design kit",
        href: "/get-started/kit-forum",
    },
];
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <ContentsPanel>
                    <ContentsPanelListHeading
                        >Set up guides</ContentsPanelListHeading
                    >
                    <ContentsPanelList>
                        {
                            useTheKitPages.map((category) => (
                                <ContentsPanelItem
                                    href={category.href}
                                    current={currentPath.includes(
                                        category.href,
                                    )}
                                >
                                    {category.text}
                                </ContentsPanelItem>
                            ))
                        }
                    </ContentsPanelList>
                    <ContentsPanelListHeading
                        >Contribution guides</ContentsPanelListHeading
                    >
                    <ContentsPanelList>
                        {
                            collaboratePages.map((category) => (
                                <ContentsPanelItem
                                    href={category.href}
                                    current={currentPath.includes(
                                        category.href,
                                    )}
                                >
                                    {category.text}
                                </ContentsPanelItem>
                            ))
                        }
                    </ContentsPanelList>
                </ContentsPanel>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/get-started" && (
                            <BreadcrumbItem href="/get-started">
                                Get started
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
