---
import Layout from "@layouts/ComponentsLayout.astro";
import ToggleItem from "@components/toggle/toggle-item.astro";
import ToggleLabel from "@components/toggle/toggle-label.astro";
import Toggle from "@components/toggle/toggle.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Toggle</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <div class="component-container">
    <ToggleItem>
      <ToggleLabel for="toggle"> Toggle label </ToggleLabel>
      <Toggle id="toggle" name="toggle" />
    </ToggleItem>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import ToggleItem from "@components/toggle/toggle-item.astro";
import ToggleLabel from "@components/toggle/toggle-label.astro";
import Toggle from "@components/toggle/toggle.astro";
---

<ToggleItem>
  <ToggleLabel for="toggle"> Toggle label </ToggleLabel>
  <Toggle id="toggle" />
</ToggleItem>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<div class="iai-toggle__item" data-module="govuk-toggle">
    <label class="govuk-label iai-toggle__label" for="toggle">
      Toggle label
    </label>
    <input class="iai-toggle__input" type="checkbox" id="toggle">
  </div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>
  <h2 class="govuk-heading-l">When to use this component</h2>

  <p class="govuk-body">
    Use the toggle when a user changes a setting that takes effect immediately,
    with no submit step, and the setting has a sensible default state of on or
    off.
  </p>

  <h2 class="govuk-heading-l">When not to use this component</h2>

  <p class="govuk-body">
    Do not use the toggle if the change needs a submit button to take effect, if
    there is no sensible default state, or if the choice is a yes/no answer to a
    question — use a checkbox or two radio buttons instead.
  </p>
  <h2 class="govuk-heading-l">Accessibility</h2>
  <h3 class="govuk-heading-m">Progressive enhancement</h3>
  <p class="govuk-body">
    The toggle component renders as a checkbox if js is disabled.
  </p>
</Layout>
