---
import Layout from "@layouts/ComponentsLayout.astro";
import ToggleItem from "@components/toggle/toggle-item.astro";
import ToggleLabel from "@components/toggle/toggle-label.astro";
import Toggle from "@components/toggle/toggle.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Toggle</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <div class="component-container">
    <ToggleItem>
      <ToggleLabel for="toggle"> Toggle label </ToggleLabel>
      <Toggle id="toggle" name="toggle" />
    </ToggleItem>
  </div>
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import ToggleItem from "@components/toggle/toggle-item.astro";
import ToggleLabel from "@components/toggle/toggle-label.astro";
import Toggle from "@components/toggle/toggle.astro";
---

    <ToggleItem>
        <ToggleLabel for="toggle"> Toggle label </ToggleLabel>
        <Toggle id="toggle" />
    </ToggleItem>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<div class="govuk-checkboxes__item iai-toggle__item">
    <label class="govuk-label govuk-checkboxes__label" for="toggle">
      Toggle label
    </label>
    <div class="iai-toggle">
      <input class="govuk-checkboxes__input iai-toggle__input" type="checkbox" id="toggle" role="switch">
      <span class="iai-toggle__display" hidden>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--checkmark" width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.08471 10.6237L2.29164 6.83059L1 8.11313L6.08471 13.1978L17 2.28255L15.7175 1L6.08471 10.6237Z" fill="currentcolor" stroke="currentcolor"></path></svg>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--cross" width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.167 0L6.5 4.667L1.833 0L0 1.833L4.667 6.5L0 11.167L1.833 13L6.5 8.333L11.167 13L13 11.167L8.333 6.5L13 1.833L11.167 0Z" fill="currentcolor"></path></svg>
      </span>
    </div>
  </div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>
  <h2 class="govuk-heading-m">Sizes</h2>
  <p class="govuk-body">
    Use the <code>size</code> prop to render a small or large toggle. Medium is the
    default.
  </p>
  <div class="component-container">
    <ToggleItem>
      <ToggleLabel for="toggle-small"> Small toggle </ToggleLabel>
      <Toggle id="toggle-small" size="small" />
    </ToggleItem>
    <ToggleItem>
      <ToggleLabel for="toggle-medium"> Medium toggle </ToggleLabel>
      <Toggle id="toggle-medium" />
    </ToggleItem>
    <ToggleItem>
      <ToggleLabel for="toggle-large"> Large toggle </ToggleLabel>
      <Toggle id="toggle-large" size="large" />
    </ToggleItem>
  </div>
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#sizes-astro" selected>Astro</Tab>
          <Tab href="#sizes-html">HTML</Tab>
        </TabsList>
        <TabPanel id="sizes-astro">
          <Code
            code={`---
import ToggleItem from "@components/toggle/toggle-item.astro";
import ToggleLabel from "@components/toggle/toggle-label.astro";
import Toggle from "@components/toggle/toggle.astro";
---

    <ToggleItem>
        <ToggleLabel for="toggle-small"> Small toggle </ToggleLabel>
        <Toggle id="toggle-small" size="small" />
    </ToggleItem>
    <ToggleItem>
        <ToggleLabel for="toggle-medium"> Medium toggle </ToggleLabel>
        <Toggle id="toggle-medium" />
    </ToggleItem>

    <ToggleItem>
        <ToggleLabel for="toggle-large"> Large toggle </ToggleLabel>
        <Toggle id="toggle-large" size="large" />
    </ToggleItem>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="sizes-html" hidden>
          <Code
            code={`<div class="govuk-checkboxes__item iai-toggle__item">
    <label class="govuk-label govuk-checkboxes__label" for="toggle-small">
      Small toggle
    </label>
    <div class="iai-toggle iai-toggle--small">
      <input class="govuk-checkboxes__input iai-toggle__input" type="checkbox" id="toggle-small" role="switch">
      <span class="iai-toggle__display" hidden>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--checkmark" width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.08471 10.6237L2.29164 6.83059L1 8.11313L6.08471 13.1978L17 2.28255L15.7175 1L6.08471 10.6237Z" fill="currentcolor" stroke="currentcolor"></path></svg>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--cross" width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.167 0L6.5 4.667L1.833 0L0 1.833L4.667 6.5L0 11.167L1.833 13L6.5 8.333L11.167 13L13 11.167L8.333 6.5L13 1.833L11.167 0Z" fill="currentcolor"></path></svg>
      </span>
    </div>
  </div>

  <div class="govuk-checkboxes__item iai-toggle__item">
    <label class="govuk-label govuk-checkboxes__label" for="toggle-medium">
      Medium toggle
    </label>
    <div class="iai-toggle">
      <input class="govuk-checkboxes__input iai-toggle__input" type="checkbox" id="toggle-medium" role="switch">
      <span class="iai-toggle__display" hidden>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--checkmark" width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.08471 10.6237L2.29164 6.83059L1 8.11313L6.08471 13.1978L17 2.28255L15.7175 1L6.08471 10.6237Z" fill="currentcolor" stroke="currentcolor"></path></svg>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--cross" width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.167 0L6.5 4.667L1.833 0L0 1.833L4.667 6.5L0 11.167L1.833 13L6.5 8.333L11.167 13L13 11.167L8.333 6.5L13 1.833L11.167 0Z" fill="currentcolor"></path></svg>
      </span>
    </div>
  </div>

  <div class="govuk-checkboxes__item iai-toggle__item">
    <label class="govuk-label govuk-checkboxes__label" for="toggle-large">
      Large toggle
    </label>
    <div class="iai-toggle iai-toggle--large">
      <input class="govuk-checkboxes__input iai-toggle__input" type="checkbox" id="toggle-large" role="switch">
      <span class="iai-toggle__display" hidden>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--checkmark" width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.08471 10.6237L2.29164 6.83059L1 8.11313L6.08471 13.1978L17 2.28255L15.7175 1L6.08471 10.6237Z" fill="currentcolor" stroke="currentcolor"></path></svg>
        <svg aria-hidden="true" focusable="false" class="iai-toggle__icon iai-toggle__icon--cross" width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.167 0L6.5 4.667L1.833 0L0 1.833L4.667 6.5L0 11.167L1.833 13L6.5 8.333L11.167 13L13 11.167L8.333 6.5L13 1.833L11.167 0Z" fill="currentcolor"></path></svg>
      </span>
    </div>
  </div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>
  <h2 class="govuk-heading-l">When to use this component</h2>

  <p class="govuk-body">
    Use the toggle when a user changes a setting that takes effect immediately,
    with no submit step, and the setting has a sensible default state of on or
    off.
  </p>

  <h2 class="govuk-heading-l">When not to use this component</h2>

  <p class="govuk-body">
    Do not use the toggle if the change needs a submit button to take effect, if
    there is no sensible default state, or if the choice is a yes/no answer to a
    question — use a checkbox or two radio buttons instead.
  </p>
</Layout>
