              >
                Navigation item 2
              </a>
            </li>
            <li class="govuk-service-navigation__item">
              <a
                class="govuk-service-navigation__link"
                href="#/3"
                aria-current="false"
              >
                Navigation item 3
              </a>
            </li>
            <li class="govuk-service-navigation__item">
              <a
                class="govuk-service-navigation__link"
                href="#/4"
                aria-current="false"
              >
                Navigation item 4
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <div
    style="flex: 1; border: 1px solid var(--govuk-border-colour);"
    class="govuk-!-padding-6"
  >
    Page content
  </div>
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the Service navigation to help users understand that they’re using your
    service.
  </p>
  <p class="govuk-body">
    To decide when to use navigation links in your service, see the <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/patterns/navigate-a-service/"
      >Help users to navigate a service pattern</a
    >.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
