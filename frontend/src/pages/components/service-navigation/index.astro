---
import Layout from "@layouts/ComponentsLayout.astro";
import ServiceNavigation from "@components/service-navigation/service-navigation.astro";
import ServiceNavigationItem from "@components/service-navigation/service-navigation-item.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Service navigation</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    Use the default service navigation to help users navigate around your
    service.
  </p>
  <ServiceNavigation isWebVersion>
    <ServiceNavigationItem href="#/1">
      Navigation item 1
    </ServiceNavigationItem>
    <ServiceNavigationItem href="#/2">
      Navigation item 2
    </ServiceNavigationItem>
    <ServiceNavigationItem href="#/3">
      Navigation item 3
    </ServiceNavigationItem>
  </ServiceNavigation>

  <h2 class="govuk-heading-m">Inverse</h2>
  <p class="govuk-body">
    Use the inverse service navigation on dark backgrounds.
  </p>
  <div class="inverse-component-container">
    <ServiceNavigation isWebVersion inverse>
      <ServiceNavigationItem href="#/1">
        Navigation item 1
      </ServiceNavigationItem>
      <ServiceNavigationItem href="#/2">
        Navigation item 2
      </ServiceNavigationItem>
      <ServiceNavigationItem href="#/3">
        Navigation item 3
      </ServiceNavigationItem>
    </ServiceNavigation>
  </div>

  <h2 class="govuk-heading-m">Side navigation</h2>
  <p class="govuk-body">
    Use the side navigation variant to display navigation vertically alongside
    page content.
  </p>
  <div style="display: flex;">
    <ServiceNavigation>
      <ServiceNavigationItem href="#/1">Navigation item 1</ServiceNavigationItem
      >
      <ServiceNavigationItem href="#/2">Navigation item 2</ServiceNavigationItem
      >
      <ServiceNavigationItem href="#/3">Navigation item 3</ServiceNavigationItem
      >
      <ServiceNavigationItem href="#/4">Navigation item 4</ServiceNavigationItem
      >
    </ServiceNavigation>
    <div
      style="flex: 1; border: 1px solid var(--govuk-border-colour);"
      class="govuk-!-padding-6"
    >
      Page content
    </div>
  </div>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the Service navigation to help users understand that they’re using your
    service.
  </p>
  <p class="govuk-body">
    To decide when to use navigation links in your service, see the <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/patterns/navigate-a-service/"
      >Help users to navigate a service pattern</a
    >.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
