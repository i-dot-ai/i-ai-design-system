              aria-current="false"
            >
              Navigation item 1
            </a>
          </li>
          <li class="govuk-service-navigation__item">
            <a
              class="govuk-service-navigation__link"
              href="#/2"
              aria-current="false"
            >
              Navigation item 2
            </a>
          </li>
          <li class="govuk-service-navigation__item">
            <a
              class="govuk-service-navigation__link"
              href="#/3"
              aria-current="false"
            >
              Navigation item 3
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <h2 class="govuk-heading-m">Side navigation</h2>
  <p class="govuk-body">
    Use the side navigation variant to display navigation vertically alongside
    page content.
  </p>
  <div class="component-container">
    <div style="display: flex;">
      <ServiceNavigation sideNav navigationId="side-nav-navigation">
        <ServiceNavigationItem href="#/1"
          >Navigation item 1</ServiceNavigationItem
        >
        <ServiceNavigationItem href="#/2"
          >Navigation item 2</ServiceNavigationItem
        >
        <ServiceNavigationItem href="#/3"
          >Navigation item 3</ServiceNavigationItem
        >
        <ServiceNavigationItem href="#/4"
          >Navigation item 4</ServiceNavigationItem
        >
      </ServiceNavigation>
      <div
        style="flex: 1; border: 1px solid var(--govuk-border-colour);"
        class="govuk-!-padding-6"
      >
        Page content
      </div>
    </div>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#side-navigation-astro" selected>Astro</Tab>
          <Tab href="#side-navigation-html">HTML</Tab>
        </TabsList>
        <TabPanel id="side-navigation-astro">
          <Code
            code={`---
import ServiceNavigation from "@components/service-navigation/service-navigation.astro";
import ServiceNavigationItem from "@components/service-navigation/service-navigation-item.astro";
---

<div style="display: flex;">
  <ServiceNavigation sideNav navigationId="side-nav-navigation">
