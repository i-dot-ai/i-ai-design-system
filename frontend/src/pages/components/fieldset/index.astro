---
import Layout from "@layouts/ComponentsLayout.astro";
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Fieldset</h1>

  <h2 class="govuk-heading-m">Extra large legend</h2>
  <p class="govuk-body">
    Use an extra large legend when the fieldset is the main focus of the page.
  </p>
  <Fieldset>
    <FieldsetLegend size="xl">What is your address?</FieldsetLegend>
  </Fieldset>
  <h2 class="govuk-heading-m">Large legend</h2>
  <p class="govuk-body">
    Use a large legend for a fieldset that is an important part of the page.
  </p>
  <Fieldset>
    <FieldsetLegend size="large">What is your address?</FieldsetLegend>
  </Fieldset>
  <h2 class="govuk-heading-m">Medium legend</h2>
  <p class="govuk-body">
    Use a medium legend for a fieldset within a section of the page.
  </p>
  <Fieldset>
    <FieldsetLegend size="medium">What is your address?</FieldsetLegend>
  </Fieldset>
  <h2 class="govuk-heading-m">Small legend</h2>
  <p class="govuk-body">
    Use a small legend for a fieldset that is not the main focus of the page.
  </p>
  <Fieldset>
    <FieldsetLegend size="small">What is your address?</FieldsetLegend>
  </Fieldset>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the fieldset component when you need to show a relationship between
    multiple form inputs. For example, you may need to group a set of text
    inputs into a single fieldset when <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/patterns/addresses/"
      >asking for an address in your service</a
    >.
  </p>
  <p class="govuk-body">
    If you’re using the examples or macros for a <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/radios/"
      >Radios component</a
    >, <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/checkboxes/"
      >Checkboxes component</a
    > or <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/date-input/"
      >Date input component</a
    >, the fieldset will already be included.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
