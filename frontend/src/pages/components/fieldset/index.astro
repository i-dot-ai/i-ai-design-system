            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>
  <h2 class="govuk-heading-m">Medium legend</h2>
  <p class="govuk-body">
    Use a medium legend for a fieldset within a section of the page.
  </p>
  <div class="component-container">
