---
import Layout from "@layouts/ComponentsLayout.astro";
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Fieldset</h1>

  <h2 class="govuk-heading-m">Extra large legend</h2>
  <p class="govuk-body">
    Use an extra large legend when the fieldset is the main focus of the page.
  </p>
  <div class="component-container">
    <Fieldset>
      <FieldsetLegend size="xl">What is your address?</FieldsetLegend>
    </Fieldset>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#extra-large-legend-astro" selected>Astro</Tab>
          <Tab href="#extra-large-legend-html">HTML</Tab>
        </TabsList>
        <TabPanel id="extra-large-legend-astro">
          <Code
            code={`---
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
---

<Fieldset>
  <FieldsetLegend size="xl">What is your address?</FieldsetLegend>
</Fieldset>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="extra-large-legend-html" hidden>
          <Code
            code={`<fieldset class="govuk-fieldset">
  <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
    What is your address?
  </legend>
</fieldset>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>
  <h2 class="govuk-heading-m">Large legend</h2>
  <p class="govuk-body">
    Use a large legend for a fieldset that is an important part of the page.
  </p>
  <div class="component-container">
    <Fieldset>
      <FieldsetLegend size="large">What is your address?</FieldsetLegend>
    </Fieldset>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
