  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
        <h2 class="govuk-heading-l">When to use this component</h2>
          <p class="govuk-body">Use the fieldset component when you need to show a relationship between multiple form inputs. For example, you may need to group a set of text inputs into a single fieldset when <a class="govuk-link" href="https://design-system.service.gov.uk/patterns/addresses/">asking for an address in your service</a>.</p>
          <p class="govuk-body">If you’re using the examples or macros for a <a class="govuk-link" href="/components/radios/">Radios component</a>, <a class="govuk-link" href="/components/checkboxes/">Checkboxes component</a> or <a class="govuk-link" href="/components/date-input/">Date input component</a>, the fieldset will already be included.</p>
        <!-- GOVUK_GUIDANCE:END -->
</Layout>
