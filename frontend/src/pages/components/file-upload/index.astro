---
import Layout from "@layouts/ComponentsLayout.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">File upload</h1>
  <p class="govuk-body-l">Help users select and upload a file</p>

  <h2 class="govuk-heading-l">Example</h2>
  <div class="govuk-form-group">
    <label class="govuk-label" for="file-upload-1"> Upload a file </label>
    <input
      class="govuk-file-upload"
      id="file-upload-1"
      name="file-upload-1"
      type="file"
    />
  </div>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    You should only ask users to upload something if it’s critical to the
    delivery of your service.
  </p>
  <p class="govuk-body">
    We improved the component in March 2025, so you’ll need to enable the <a
      class="govuk-link"
      href="#using-the-improved-file-upload-component"
      >improved File upload component</a
    > as a new feature.
  </p>
  <p class="govuk-body">
    Read a blog post about <a
      class="govuk-link"
      href="https://designnotes.blog.gov.uk/2017/02/14/some-design-tips-for-uploading-things/"
      >design tips for helping users upload things</a
    >.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
