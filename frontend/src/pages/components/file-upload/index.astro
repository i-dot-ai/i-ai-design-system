---
import Layout from "@layouts/ComponentsLayout.astro";
import FormGroup from "@components/form-group/form-group.astro";
import InputLabel from "@components/input-label/input-label.astro";
import FileUpload from "@components/file-upload/file-upload.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">File upload</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    A default file upload lets users select and upload a single file.
  </p>
  <div class="component-container">
    <FormGroup>
      <InputLabel for="file-upload-1">Upload a file</InputLabel>
      <FileUpload id="file-upload-1" name="file-upload-1" />
    </FormGroup>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import FormGroup from "@components/form-group/form-group.astro";
import InputLabel from "@components/input-label/input-label.astro";
import FileUpload from "@components/file-upload/file-upload.astro";
---

<FormGroup>
  <InputLabel for="file-upload-1">Upload a file</InputLabel>
  <FileUpload id="file-upload-1" name="file-upload-1" />
</FormGroup>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<div class="govuk-form-group">
  <label class="govuk-label" for="file-upload-1">Upload a file</label>
  <input class="govuk-file-upload" type="file" id="file-upload-1" name="file-upload-1">
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    You should only ask users to upload something if it’s critical to the
    delivery of your service.
  </p>
  <p class="govuk-body">
    We improved the component in March 2025, so you’ll need to enable the <a
      class="govuk-link"
      href="#using-the-improved-file-upload-component"
      >improved File upload component</a
    > as a new feature.
  </p>
  <p class="govuk-body">
    Read a blog post about <a
      class="govuk-link"
      href="https://designnotes.blog.gov.uk/2017/02/14/some-design-tips-for-uploading-things/"
      >design tips for helping users upload things</a
    >.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
