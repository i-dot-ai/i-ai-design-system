---
import Layout from "@layouts/ComponentsLayout.astro";
import Table from "@components/table/table.astro";
import TableCaption from "@components/table/table-caption.astro";
import TableHead from "@components/table/table-head.astro";
import TableBody from "@components/table/table-body.astro";
import TableRow from "@components/table/table-row.astro";
import TableHeader from "@components/table/table-header.astro";
import TableCell from "@components/table/table-cell.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Table</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    A default table lets users compare information in rows and columns.
  </p>
  <div class="component-container">
    <Table>
      <TableCaption size="medium">Monthly energy costs</TableCaption>
      <TableHead>
        <TableRow>
          <TableHeader>Month</TableHeader>
          <TableHeader numeric>Gas</TableHeader>
          <TableHeader numeric>Electricity</TableHeader>
        </TableRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableCell>January</TableCell>
          <TableCell numeric>£85</TableCell>
          <TableCell numeric>£95</TableCell>
        </TableRow>
        <TableRow>
          <TableCell>February</TableCell>
          <TableCell numeric>£75</TableCell>
          <TableCell numeric>£55</TableCell>
        </TableRow>
        <TableRow>
          <TableCell>March</TableCell>
          <TableCell numeric>£165</TableCell>
          <TableCell numeric>£125</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import Table from "@components/table/table.astro";
import TableCaption from "@components/table/table-caption.astro";
import TableHead from "@components/table/table-head.astro";
import TableBody from "@components/table/table-body.astro";
import TableRow from "@components/table/table-row.astro";
import TableHeader from "@components/table/table-header.astro";
import TableCell from "@components/table/table-cell.astro";
---

<Table>
  <TableCaption size="medium">Monthly energy costs</TableCaption>
  <TableHead>
    <TableRow>
      <TableHeader>Month</TableHeader>
      <TableHeader numeric>Gas</TableHeader>
      <TableHeader numeric>Electricity</TableHeader>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell>January</TableCell>
      <TableCell numeric>£85</TableCell>
      <TableCell numeric>£95</TableCell>
    </TableRow>
    <TableRow>
      <TableCell>February</TableCell>
      <TableCell numeric>£75</TableCell>
      <TableCell numeric>£55</TableCell>
    </TableRow>
    <TableRow>
      <TableCell>March</TableCell>
      <TableCell numeric>£165</TableCell>
      <TableCell numeric>£125</TableCell>
    </TableRow>
  </TableBody>
</Table>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<table class="govuk-table">
  <caption class="govuk-table__caption govuk-table__caption--m">
    Monthly energy costs
  </caption>
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header" scope="col">Month</th>
      <th class="govuk-table__header govuk-table__header--numeric" scope="col">
        Gas
      </th>
      <th class="govuk-table__header govuk-table__header--numeric" scope="col">
        Electricity
      </th>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    <tr class="govuk-table__row">
      <td class="govuk-table__cell">January</td>
      <td class="govuk-table__cell govuk-table__cell--numeric">£85</td>
      <td class="govuk-table__cell govuk-table__cell--numeric">£95</td>
    </tr>
    <tr class="govuk-table__row">
      <td class="govuk-table__cell">February</td>
      <td class="govuk-table__cell govuk-table__cell--numeric">£75</td>
      <td class="govuk-table__cell govuk-table__cell--numeric">£55</td>
    </tr>
    <tr class="govuk-table__row">
      <td class="govuk-table__cell">March</td>
      <td class="govuk-table__cell govuk-table__cell--numeric">£165</td>
      <td class="govuk-table__cell govuk-table__cell--numeric">£125</td>
    </tr>
  </tbody>
</table>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <h2 class="govuk-heading-m">Subtle</h2>
