---
import Layout from "@layouts/ComponentsLayout.astro";
import BackLink from "@components/back-link/back-link.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Back link</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    Use the default back link to help users go back to the previous page.
  </p>
  <div class="component-container">
    <BackLink href="#">Back</BackLink>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import BackLink from "@components/back-link/back-link.astro";
---

<BackLink href="#">Back</BackLink>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<a class="govuk-back-link" href="#">Back</a>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>
  <h2 class="govuk-heading-m">Inverse</h2>
  <p class="govuk-body">Use the inverse back link on dark backgrounds.</p>
  <div class="component-container--inverse">
    <BackLink href="#" inverse>Back</BackLink>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#inverse-astro" selected>Astro</Tab>
          <Tab href="#inverse-html">HTML</Tab>
        </TabsList>
        <TabPanel id="inverse-astro">
          <Code
            code={`---
import BackLink from "@components/back-link/back-link.astro";
---

<BackLink href="#" inverse>Back</BackLink>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="inverse-html" hidden>
          <Code
            code={`<a class="govuk-back-link govuk-back-link--inverse" href="#">Back</a>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
        <h2 class="govuk-heading-l">When to use this component</h2>
          <p class="govuk-body">Always include the Back link component on GOV.UK <a class="govuk-link" href="https://design-system.service.gov.uk/patterns/question-pages/">Question pages in your service</a>.</p>
          <p class="govuk-body">You can include a back link on other pages within a multi-page transaction, if it makes sense to do so.</p>
        <h2 class="govuk-heading-l">When not to use this component</h2>
          <p class="govuk-body">Never use the back link component together with the <a class="govuk-link" href="/components/breadcrumbs/">Breadcrumbs component</a>. If necessary, you should do research with your users to learn which they find more helpful in your service.</p>
        <!-- GOVUK_GUIDANCE:END -->
</Layout>
