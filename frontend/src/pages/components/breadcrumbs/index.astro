---
import Layout from "@layouts/ComponentsLayout.astro";
import Breadcrumbs from "@components/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@components/breadcrumbs/breadcrumbItem.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Breadcrumbs</h1>
  <p class="govuk-body-l">
    Help users orientate themselves and navigate pages within a hierarchical
    structure
  </p>

  <h2 class="govuk-heading-l">Example</h2>
  <Breadcrumbs>
    <BreadcrumbItem href="#">Home</BreadcrumbItem>
    <BreadcrumbItem href="#">Section</BreadcrumbItem>
    <BreadcrumbItem href="#">Sub-section</BreadcrumbItem>
    <BreadcrumbItem href="#">Sub Sub-section</BreadcrumbItem>
  </Breadcrumbs>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the breadcrumbs component when you need to help users understand and
    move between the multiple levels of a website.
  </p>
  <h2 class="govuk-heading-l">When not to use this component</h2>
  <p class="govuk-body">
    Do not use the breadcrumbs component on websites with a flat structure, or
    to show progress through a linear journey or transaction.
  </p>
  <p class="govuk-body">
    If you’re using other navigational elements on the page, such as a sidebar,
    consider whether your users need the additional support of breadcrumbs.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
