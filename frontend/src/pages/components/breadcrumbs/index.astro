---
import Layout from "@layouts/ComponentsLayout.astro";
import Breadcrumbs from "@components/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@components/breadcrumbs/breadcrumb-item.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Breadcrumbs</h1>

  <h2 class="govuk-heading-m">Example</h2>
  <div class="component-container">
    <Breadcrumbs>
      <BreadcrumbItem href="#">Home</BreadcrumbItem>
      <BreadcrumbItem href="#">Section</BreadcrumbItem>
      <BreadcrumbItem href="#">Sub-section</BreadcrumbItem>
      <BreadcrumbItem href="#">Sub Sub-section</BreadcrumbItem>
    </Breadcrumbs>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#example-astro" selected>Astro</Tab>
          <Tab href="#example-html">HTML</Tab>
        </TabsList>
        <TabPanel id="example-astro">
          <Code
            code={`---
import Breadcrumbs from "@components/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@components/breadcrumbs/breadcrumb-item.astro";
---

<Breadcrumbs>
  <BreadcrumbItem href="#">Home</BreadcrumbItem>
  <BreadcrumbItem href="#">Section</BreadcrumbItem>
  <BreadcrumbItem href="#">Sub-section</BreadcrumbItem>
  <BreadcrumbItem href="#">Sub Sub-section</BreadcrumbItem>
</Breadcrumbs>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="example-html" hidden>
          <Code
            code={`<nav aria-label="Breadcrumb" class="govuk-breadcrumbs">
  <ol class="govuk-breadcrumbs__list">
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Home</a>
    </li>
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Section</a>
    </li>
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Sub-section</a>
    </li>
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Sub Sub-section</a>
    </li>
  </ol>
</nav>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <h2 class="govuk-heading-m">Inverse</h2>
  <p class="govuk-body">Use the inverse breadcrumbs on dark backgrounds.</p>
  <div class="component-container--inverse">
    <Breadcrumbs inverse>
      <BreadcrumbItem href="#">Home</BreadcrumbItem>
      <BreadcrumbItem href="#">Section</BreadcrumbItem>
      <BreadcrumbItem href="#">Sub-section</BreadcrumbItem>
      <BreadcrumbItem href="#">Sub Sub-section</BreadcrumbItem>
    </Breadcrumbs>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#inverse-astro" selected>Astro</Tab>
          <Tab href="#inverse-html">HTML</Tab>
        </TabsList>
        <TabPanel id="inverse-astro">
          <Code
            code={`---
import Breadcrumbs from "@components/breadcrumbs/breadcrumbs.astro";
import BreadcrumbItem from "@components/breadcrumbs/breadcrumb-item.astro";
---

<Breadcrumbs inverse>
  <BreadcrumbItem href="#">Home</BreadcrumbItem>
  <BreadcrumbItem href="#">Section</BreadcrumbItem>
  <BreadcrumbItem href="#">Sub-section</BreadcrumbItem>
  <BreadcrumbItem href="#">Sub Sub-section</BreadcrumbItem>
</Breadcrumbs>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="inverse-html" hidden>
          <Code
            code={`<nav aria-label="Breadcrumb" class="govuk-breadcrumbs govuk-breadcrumbs--inverse">
  <ol class="govuk-breadcrumbs__list">
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Home</a>
    </li>
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Section</a>
    </li>
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Sub-section</a>
    </li>
    <li class="govuk-breadcrumbs__list-item">
      <a href="#" class="govuk-breadcrumbs__link">Sub Sub-section</a>
    </li>
  </ol>
</nav>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
        <h2 class="govuk-heading-l">When to use this component</h2>
          <p class="govuk-body">Use the breadcrumbs component when you need to help users understand and move between the multiple levels of a website.</p>
        <h2 class="govuk-heading-l">When not to use this component</h2>
          <p class="govuk-body">Do not use the breadcrumbs component on websites with a flat structure, or to show progress through a linear journey or transaction.</p>
          <p class="govuk-body">If you’re using other navigational elements on the page, such as a sidebar, consider whether your users need the additional support of breadcrumbs.</p>
        <!-- GOVUK_GUIDANCE:END -->
</Layout>
