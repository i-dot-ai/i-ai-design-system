---
import Layout from "@layouts/ComponentsLayout.astro";
import ErrorMessage from "@components/error-message/error-message.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Error message</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    The default error message uses a visually hidden prefix of "Error:".
  </p>
  <div class="component-container">
    <ErrorMessage>Error message about full name goes here</ErrorMessage>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import ErrorMessage from "@components/error-message/error-message.astro";
---

<ErrorMessage>Error message about full name goes here</ErrorMessage>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<p class="govuk-error-message">
  <span class="govuk-visually-hidden">Error:</span>
  Error message about full name goes here
</p>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Show an error message next to the field and in the <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/error-summary/"
      >Error summary component</a
    > when there is a validation error.
  </p>
  <p class="govuk-body">Use standard messages for different components.</p>
  <h2 class="govuk-heading-l">When not to use this component</h2>
  <p class="govuk-body">
    Do not use error messages to tell a user that they are not eligible or do
    not have permission to do something. Or to tell them about a lack of
    capacity or other problem the user cannot fix - because the problem is with
    the service rather than with the information the user has provided.
  </p>
  <p class="govuk-body">
    Instead, take the user to a page that explains the problem (for example,
    telling them why they’re not eligible) and provides useful information about
    what to do next.
  </p>
  <p class="govuk-body">There are separate patterns for:</p>
  <ul class="govuk-list govuk-list--bullet">
    <li>
      <a
        class="govuk-link"
        href="https://design-system.service.gov.uk/patterns/problem-with-the-service-pages/"
        >'There is a problem with the service' pages</a
      >
    </li>
    <li>
      <a
        class="govuk-link"
        href="https://design-system.service.gov.uk/patterns/page-not-found-pages/"
        >'Page not found' pages</a
      >
    </li>
    <li>
      <a
        class="govuk-link"
        href="https://design-system.service.gov.uk/patterns/service-unavailable-pages/"
        >'Service unavailable' pages</a
      >
    </li>
  </ul>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
