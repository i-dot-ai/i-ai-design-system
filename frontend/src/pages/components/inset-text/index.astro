---
import Layout from "@layouts/ComponentsLayout.astro";
import InsetText from "@components/inset-text/inset-text.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Inset text</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    Use the default inset text to differentiate a block of text from the
    content that surrounds it.
  </p>
  <div class="component-container">
    <InsetText>
      It can take up to 8 weeks to register a lasting power of attorney if there
      are no mistakes in the application.
    </InsetText>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import InsetText from "@components/inset-text/inset-text.astro";
---

<InsetText>
  It can take up to 8 weeks to register a lasting power of attorney if there
  are no mistakes in the application.
</InsetText>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<div class="govuk-inset-text">
  It can take up to 8 weeks to register a lasting power of attorney if there
  are no mistakes in the application.
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the inset text component to differentiate a block of text from the
    content that surrounds it, for example:
  </p>
  <ul class="govuk-list govuk-list--bullet">
    <li>quotes</li>
    <li>examples</li>
    <li>additional information about the page</li>
  </ul>
  <h2 class="govuk-heading-l">When not to use this component</h2>
  <p class="govuk-body">
    Some users do not notice inset text if it’s used on complex pages or near to
    other visually prominent elements. For this reason, avoid using inset text
    as a way of highlighting very important information that users need to see.
  </p>
  <p class="govuk-body">
    If you need to draw attention to very important content, like legal
    information, use the <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/warning-text/"
      >Warning text component</a
    > instead.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
