---
import Layout from "@layouts/ComponentsLayout.astro";
import FormGroup from "@components/form-group/form-group.astro";
import InputLabel from "@components/input-label/input-label.astro";
import CharacterCount from "@components/character-count/character-count.astro";
import CharacterCountMessage from "@components/character-count/character-count-message.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Character count</h1>

  <h2 class="govuk-heading-m">With maximum characters</h2>
  <p class="govuk-body">
    Use a maximum characters count to tell users how many characters they can
    enter.
  </p>
  <div class="component-container">
    <FormGroup
      class="govuk-character-count"
      data-module="govuk-character-count"
      data-maxlength={10}
    >
      <InputLabel for="more-detail">Can you provide more detail?</InputLabel>
      <CharacterCount
        id="more-detail"
        name="more-detail"
        rows="5"
        aria-describedby="more-detail-info"
      />
      <CharacterCountMessage id="more-detail-info">
        You can enter up to 10 characters
      </CharacterCountMessage>
    </FormGroup>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#with-maximum-characters-astro" selected>Astro</Tab>
          <Tab href="#with-maximum-characters-html">HTML</Tab>
        </TabsList>
        <TabPanel id="with-maximum-characters-astro">
          <Code
            code={`---
import FormGroup from "@components/form-group/form-group.astro";
import InputLabel from "@components/input-label/input-label.astro";
import CharacterCount from "@components/character-count/character-count.astro";
import CharacterCountMessage from "@components/character-count/character-count-message.astro";
---

<FormGroup
  class="govuk-character-count"
  data-module="govuk-character-count"
  data-maxlength={10}
>
  <InputLabel for="more-detail">Can you provide more detail?</InputLabel>
  <CharacterCount
    id="more-detail"
    name="more-detail"
    rows="5"
    aria-describedby="more-detail-info"
  />
  <CharacterCountMessage id="more-detail-info">
    You can enter up to 10 characters
  </CharacterCountMessage>
</FormGroup>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="with-maximum-characters-html" hidden>
          <Code
            code={`<div
  class="govuk-form-group govuk-character-count"
  data-module="govuk-character-count"
  data-maxlength="10"
>
  <label class="govuk-label" for="more-detail">
    Can you provide more detail?
  </label>
  <textarea
    class="govuk-textarea govuk-js-character-count"
    id="more-detail"
    name="more-detail"
    rows="5"
    aria-describedby="more-detail-info"
  ></textarea>
  <div class="govuk-hint govuk-character-count__message" id="more-detail-info">
    You can enter up to 10 characters
  </div>
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
        <h2 class="govuk-heading-l">When to use this component</h2>
          <p class="govuk-body">Always test your service without a character count first.</p>
          <p class="govuk-body">Only use the character count component when there is a good reason for limiting the number of characters users can enter. For example, if there is:</p>
          <ul class="govuk-list govuk-list--bullet">
            <li>evidence that users are likely to enter more information than they need to</li>
            <li>a legal or technical reason that means an entry must be no more than a certain number of characters</li>
          </ul>
        <h2 class="govuk-heading-l">When not to use this component</h2>
          <p class="govuk-body">If your users keep hitting the character limit imposed by the backend of your service then try to increase the limit rather than use a character count.</p>
        <!-- GOVUK_GUIDANCE:END -->
</Layout>
