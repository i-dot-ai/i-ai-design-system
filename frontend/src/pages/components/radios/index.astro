---
import Layout from "@layouts/ComponentsLayout.astro";
import FormGroup from "@components/form-group/form-group.astro";
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
import Radios from "@components/radios/radios.astro";
import RadioItem from "@components/radios/radio-item.astro";
import RadioInput from "@components/radios/radio-input.astro";
import InputLabel from "@components/input-label/input-label.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Radios</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    A default radios group lets users select a single option from a list.
  </p>
  <FormGroup>
    <Fieldset>
      <FieldsetLegend>Have you changed your name?</FieldsetLegend>
      <Radios>
        <RadioItem>
          <RadioInput id="changed-name" name="changed-name" value="yes" />
          <InputLabel for="changed-name" class="govuk-radios__label">
            Yes
          </InputLabel>
        </RadioItem>
        <RadioItem>
          <RadioInput id="changed-name-2" name="changed-name" value="no" />
          <InputLabel for="changed-name-2" class="govuk-radios__label">
            No
          </InputLabel>
        </RadioItem>
      </Radios>
    </Fieldset>
  </FormGroup>
  <h2 class="govuk-heading-m">Inline</h2>
  <p class="govuk-body">
    Use inline radios to display the options on a single line where there is
    enough space and only two options.
  </p>
  <FormGroup>
    <Fieldset>
      <FieldsetLegend>Have you changed your name?</FieldsetLegend>
      <Radios inline>
        <RadioItem>
          <RadioInput
            id="changed-name-inline"
            name="changed-name-inline"
            value="yes"
          />
          <InputLabel for="changed-name-inline" class="govuk-radios__label">
            Yes
          </InputLabel>
        </RadioItem>
        <RadioItem>
          <RadioInput
            id="changed-name-inline-2"
            name="changed-name-inline"
            value="no"
          />
          <InputLabel for="changed-name-inline-2" class="govuk-radios__label">
            No
          </InputLabel>
        </RadioItem>
      </Radios>
    </Fieldset>
  </FormGroup>
  <h2 class="govuk-heading-m">Small</h2>
  <p class="govuk-body">
    Use small radios when the user is unlikely to want to change their answer,
    or in a densely populated interface.
  </p>
  <FormGroup>
    <Fieldset>
      <FieldsetLegend>Have you changed your name?</FieldsetLegend>
      <Radios small>
        <RadioItem>
          <RadioInput
            id="changed-name-small"
            name="changed-name-small"
            value="yes"
          />
          <InputLabel for="changed-name-small" class="govuk-radios__label">
            Yes
          </InputLabel>
        </RadioItem>
        <RadioItem>
          <RadioInput
            id="changed-name-small-2"
            name="changed-name-small"
            value="no"
          />
          <InputLabel for="changed-name-small-2" class="govuk-radios__label">
            No
          </InputLabel>
        </RadioItem>
      </Radios>
    </Fieldset>
  </FormGroup>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the radios component when users can only select one option from a list.
  </p>
  <h2 class="govuk-heading-l">When not to use this component</h2>
  <p class="govuk-body">
    Do not use the radios component if users might need to select more than one
    option. In this case, you should use the <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/checkboxes/"
      >Checkboxes component</a
    > instead.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
