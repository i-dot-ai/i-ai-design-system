---
import Layout from "@layouts/ComponentsLayout.astro";
import FormGroup from "@components/form-group/form-group.astro";
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
import Radios from "@components/radios/radios.astro";
import RadioItem from "@components/radios/radio-item.astro";
import RadioInput from "@components/radios/radio-input.astro";
import InputLabel from "@components/input-label/input-label.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Radios</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    A default radios group lets users select a single option from a list.
  </p>
  <div class="component-container">
    <FormGroup>
      <Fieldset>
        <FieldsetLegend>Have you changed your name?</FieldsetLegend>
        <Radios>
          <RadioItem>
            <RadioInput id="changed-name" name="changed-name" value="yes" />
            <InputLabel for="changed-name" class="govuk-radios__label">
              Yes
            </InputLabel>
          </RadioItem>
          <RadioItem>
            <RadioInput id="changed-name-2" name="changed-name" value="no" />
            <InputLabel for="changed-name-2" class="govuk-radios__label">
              No
            </InputLabel>
          </RadioItem>
        </Radios>
      </Fieldset>
    </FormGroup>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import FormGroup from "@components/form-group/form-group.astro";
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
import Radios from "@components/radios/radios.astro";
import RadioItem from "@components/radios/radio-item.astro";
import RadioInput from "@components/radios/radio-input.astro";
import InputLabel from "@components/input-label/input-label.astro";
---

<FormGroup>
  <Fieldset>
    <FieldsetLegend>Have you changed your name?</FieldsetLegend>
    <Radios>
      <RadioItem>
        <RadioInput id="changed-name" name="changed-name" value="yes" />
        <InputLabel for="changed-name" class="govuk-radios__label">
          Yes
        </InputLabel>
      </RadioItem>
      <RadioItem>
        <RadioInput id="changed-name-2" name="changed-name" value="no" />
        <InputLabel for="changed-name-2" class="govuk-radios__label">
          No
        </InputLabel>
      </RadioItem>
    </Radios>
  </Fieldset>
</FormGroup>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<div class="govuk-form-group">
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend">Have you changed your name?</legend>
    <div class="govuk-radios" data-module="govuk-radios">
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" type="radio" id="changed-name" name="changed-name" value="yes">
        <label class="govuk-label govuk-radios__label" for="changed-name">
          Yes
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" type="radio" id="changed-name-2" name="changed-name" value="no">
        <label class="govuk-label govuk-radios__label" for="changed-name-2">
          No
        </label>
      </div>
    </div>
  </fieldset>
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>
  <h2 class="govuk-heading-m">Inline</h2>
  <p class="govuk-body">
    Use inline radios to display the options on a single line where there is
    enough space and only two options.
  </p>
  <div class="component-container">
