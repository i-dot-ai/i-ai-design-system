---
import Layout from "@layouts/ComponentsLayout.astro";
import WarningText from "@components/warning-text/warning-text.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Warning text</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    The default warning text uses a visually hidden fallback of "Warning" for
    the icon.
  </p>
  <WarningText>
    You can be fined up to £5,000 if you don’t register.
  </WarningText>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the warning text component when you need to warn users about something
    important, such as legal consequences of an action, or lack of action, that
    they might take.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
