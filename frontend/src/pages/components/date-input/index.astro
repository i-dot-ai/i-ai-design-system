---
import Layout from "@layouts/ComponentsLayout.astro";
import FormGroup from "@components/form-group/form-group.astro";
import InputLabel from "@components/input-label/input-label.astro";
import Hint from "@components/hint/hint.astro";
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
import DateInput from "@components/date-input/date-input.astro";
import DateInputItem from "@components/date-input/date-input-item.astro";
import DateInputField from "@components/date-input/date-input-field.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Date input</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    A default date input lets users enter a day, month and year.
  </p>
  <FormGroup>
    <Fieldset role="group" aria-describedby="dob-hint">
      <FieldsetLegend>What is your date of birth?</FieldsetLegend>
      <Hint id="dob-hint">For example, 31 3 1980</Hint>
      <DateInput id="dob">
        <DateInputItem>
          <FormGroup>
            <InputLabel for="dob-day" class="govuk-date-input__label"
              >Day</InputLabel
            >
            <DateInputField id="dob-day" name="day" width={2} />
          </FormGroup>
        </DateInputItem>
        <DateInputItem>
          <FormGroup>
            <InputLabel for="dob-month" class="govuk-date-input__label"
              >Month</InputLabel
            >
            <DateInputField id="dob-month" name="month" width={2} />
          </FormGroup>
        </DateInputItem>
        <DateInputItem>
          <FormGroup>
            <InputLabel for="dob-year" class="govuk-date-input__label"
              >Year</InputLabel
            >
            <DateInputField id="dob-year" name="year" width={4} />
          </FormGroup>
        </DateInputItem>
      </DateInput>
    </Fieldset>
  </FormGroup>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the date input component when you’re asking users for a date they’ll
    already know, or can look up without using a calendar.
  </p>
  <h2 class="govuk-heading-l">When not to use this component</h2>
  <p class="govuk-body">
    Do not use the date input component if users are unlikely to know the exact
    date of the event you’re asking about.
  </p>
  <p class="govuk-body">
    Read more in the <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/patterns/dates/"
      >Ask users for dates pattern</a
    >.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
