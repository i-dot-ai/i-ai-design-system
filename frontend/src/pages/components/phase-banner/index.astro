---
import Layout from "@layouts/ComponentsLayout.astro";
import PhaseBanner from "@components/phase-banner/phase-banner.astro";
import PhaseBannerText from "@components/phase-banner/phase-banner-text.astro";
import Tag from "@components/tag/tag.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Phase banner</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    Use the default phase banner with a tag to show the phase of your service.
  </p>
  <div class="component-container">
    <PhaseBanner>
      <Tag class="govuk-phase-banner__content__tag">Alpha</Tag>
      <PhaseBannerText>
        This is a new service - your <a href="#" class="govuk-link">feedback</a> will
        help us to improve it.
      </PhaseBannerText>
    </PhaseBanner>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import PhaseBanner from "@components/phase-banner/phase-banner.astro";
import PhaseBannerText from "@components/phase-banner/phase-banner-text.astro";
import Tag from "@components/tag/tag.astro";
---

<PhaseBanner>
  <Tag class="govuk-phase-banner__content__tag">Alpha</Tag>
  <PhaseBannerText>
    This is a new service - your <a href="#" class="govuk-link">feedback</a> will
    help us to improve it.
  </PhaseBannerText>
</PhaseBanner>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<div class="govuk-phase-banner">
  <p class="govuk-phase-banner__content">
    <strong class="govuk-tag govuk-phase-banner__content__tag">Alpha</strong>
    <span class="govuk-phase-banner__text">
      This is a new service - your <a href="#" class="govuk-link">feedback</a> will
      help us to improve it.
    </span>
  </p>
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
        <h2 class="govuk-heading-l">When to use this component</h2>
          <p class="govuk-body">Services hosted on a service.gov.uk domain must use the phase banner until they pass a live assessment.</p>
        <!-- GOVUK_GUIDANCE:END -->
</Layout>
