---
import Layout from "@layouts/ComponentsLayout.astro";
import TaskList from "@components/task-list/task-list.astro";
import TaskListItem from "@components/task-list/task-list-item.astro";
import TaskListNameAndHint from "@components/task-list/task-list-name-and-hint.astro";
import TaskListLink from "@components/task-list/task-list-link.astro";
import TaskListStatus from "@components/task-list/task-list-status.astro";
import Tag from "@components/tag/tag.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Task list</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    A default task list shows all the tasks a user needs to do and their
    status.
  </p>
  <div class="component-container">
    <TaskList>
      <TaskListItem withLink>
        <TaskListNameAndHint>
          <TaskListLink href="#" aria-describedby="status-1">
            Company Directors
          </TaskListLink>
        </TaskListNameAndHint>
        <TaskListStatus id="status-1">Completed</TaskListStatus>
      </TaskListItem>
      <TaskListItem withLink>
        <TaskListNameAndHint>
          <TaskListLink href="#" aria-describedby="status-2">
            Registered company details
          </TaskListLink>
        </TaskListNameAndHint>
        <TaskListStatus id="status-2">
          <Tag color="blue">Incomplete</Tag>
        </TaskListStatus>
      </TaskListItem>
      <TaskListItem withLink>
        <TaskListNameAndHint>
          <TaskListLink href="#" aria-describedby="status-3">
            Business plan
          </TaskListLink>
        </TaskListNameAndHint>
        <TaskListStatus id="status-3">
          <Tag color="blue">Incomplete</Tag>
        </TaskListStatus>
      </TaskListItem>
    </TaskList>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import TaskList from "@components/task-list/task-list.astro";
import TaskListItem from "@components/task-list/task-list-item.astro";
import TaskListNameAndHint from "@components/task-list/task-list-name-and-hint.astro";
import TaskListLink from "@components/task-list/task-list-link.astro";
import TaskListStatus from "@components/task-list/task-list-status.astro";
import Tag from "@components/tag/tag.astro";
---

<TaskList>
  <TaskListItem withLink>
    <TaskListNameAndHint>
      <TaskListLink href="#" aria-describedby="status-1">
        Company Directors
      </TaskListLink>
    </TaskListNameAndHint>
    <TaskListStatus id="status-1">Completed</TaskListStatus>
  </TaskListItem>
  <TaskListItem withLink>
    <TaskListNameAndHint>
      <TaskListLink href="#" aria-describedby="status-2">
        Registered company details
      </TaskListLink>
    </TaskListNameAndHint>
    <TaskListStatus id="status-2">
      <Tag color="blue">Incomplete</Tag>
    </TaskListStatus>
  </TaskListItem>
  <TaskListItem withLink>
    <TaskListNameAndHint>
      <TaskListLink href="#" aria-describedby="status-3">
        Business plan
      </TaskListLink>
    </TaskListNameAndHint>
    <TaskListStatus id="status-3">
      <Tag color="blue">Incomplete</Tag>
    </TaskListStatus>
  </TaskListItem>
</TaskList>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<ul class="govuk-task-list">
  <li class="govuk-task-list__item govuk-task-list__item--with-link">
    <div class="govuk-task-list__name-and-hint">
      <a class="govuk-link govuk-task-list__link" href="#" aria-describedby="status-1">
        Company Directors
      </a>
    </div>
    <div class="govuk-task-list__status" id="status-1">Completed</div>
  </li>
  <li class="govuk-task-list__item govuk-task-list__item--with-link">
    <div class="govuk-task-list__name-and-hint">
      <a class="govuk-link govuk-task-list__link" href="#" aria-describedby="status-2">
        Registered company details
      </a>
    </div>
    <div class="govuk-task-list__status" id="status-2">
      <strong class="govuk-tag govuk-tag--blue">Incomplete</strong>
    </div>
  </li>
  <li class="govuk-task-list__item govuk-task-list__item--with-link">
    <div class="govuk-task-list__name-and-hint">
      <a class="govuk-link govuk-task-list__link" href="#" aria-describedby="status-3">
        Business plan
      </a>
    </div>
    <div class="govuk-task-list__status" id="status-3">
      <strong class="govuk-tag govuk-tag--blue">Incomplete</strong>
    </div>
  </li>
</ul>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the task list to give users more control over how they complete long,
    complex services.
  </p>
  <p class="govuk-body">
    Only use the task list if there’s evidence that users:
  </p>
  <ul class="govuk-list govuk-list--bullet">
    <li>do not want to, or cannot, complete all the tasks in one sitting</li>
    <li>need to be able to choose the order they complete the tasks in</li>
  </ul>
  <h2 class="govuk-heading-l">When not to use this component</h2>
  <p class="govuk-body">
    Try to simplify the service before you use a task list. If you’re able to
    reduce the number of tasks or steps involved, you might not need one.
  </p>
  <p class="govuk-body">
    Do not use the task list for a long service that needs to be completed in a
    specific order. If it needs to be completed over multiple sessions, consider
    allowing users to save their progress, and then to continue where they left
    off when they return. Use the start page to explain what users will be
    expected to do during the service.
  </p>
  <p class="govuk-body">
    The task list should not be used as a way of showing users their answers.
    For this, you should use a <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/summary-list/"
      >Summary list component</a
    > instead.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
