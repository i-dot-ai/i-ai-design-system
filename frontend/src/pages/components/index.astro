---
import Layout from "@layouts/ComponentsLayout.astro";
import Example from "@components/docs/example.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("components", "index");
if (!entry) throw new Error("Missing components/index.mdx");
const { Content } = await render(entry);
---

<Layout>
  <h1 class="govuk-heading-xl">{entry.data.title}</h1>
  <Content components={{ Example }} />
</Layout>
