---
import Layout from "@layouts/ComponentsLayout.astro";
import SkipLink from "@components/skip-link/skip-link.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Skip link</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    Use the default skip link to let keyboard-only users skip to the main
    content on a page.
  </p>
  <div class="component-container">
    <SkipLink href="#content">Skip to main content</SkipLink>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import SkipLink from "@components/skip-link/skip-link.astro";
---

<SkipLink href="#content">Skip to main content</SkipLink>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<a class="govuk-skip-link" data-module="govuk-skip-link" href="#content">Skip to main content</a>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
        <h2 class="govuk-heading-l">When to use this component</h2>
          <p class="govuk-body">All GOV.UK pages must include a skip link. Usually, you should place the skip link immediately after the opening <code><body></code> tag. However, if you're using a <a class="govuk-link" href="/components/cookie-banner/">Cookie banner component</a>, place the skip link immediately after the cookie banner.</p>
          <p class="govuk-body">Some automated accessibility testing tools may warn that the skip link element is not inside a landmark. This warning does not apply to skip links, so you can ignore it. Do not wrap the skip link in a <code><nav></code> region, or move it inside the header.</p>
        <!-- GOVUK_GUIDANCE:END -->
    </p>
  </p>
</Layout>
