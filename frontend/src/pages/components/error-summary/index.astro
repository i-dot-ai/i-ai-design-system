---
import Layout from "@layouts/ComponentsLayout.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Error summary</h1>
  <p class="govuk-body-l">
    Use an error summary when there is a validation error
  </p>

  <h2 class="govuk-heading-l">Example</h2>
  <div class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <ul class="govuk-list govuk-error-summary__list">
          <li>
            <a href="#example-error-1"
              >The date your passport was issued must be in the past</a
            >
          </li>
          <li>
            <a href="#example-error-2">Enter a postcode, like AA1 1AA</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Always show an error summary when there is a validation error, even if
    there’s only one.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
