---
import Layout from "@layouts/ComponentsLayout.astro";
import ErrorSummary from "@components/error-summary/error-summary.astro";
import ErrorSummaryTitle from "@components/error-summary/error-summary-title.astro";
import ErrorSummaryBody from "@components/error-summary/error-summary-body.astro";
import ErrorSummaryList from "@components/error-summary/error-summary-list.astro";
import ErrorSummaryItem from "@components/error-summary/error-summary-item.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Error summary</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    The default error summary lists validation errors and links to each field.
  </p>
  <div class="component-container">
    <ErrorSummary>
      <ErrorSummaryTitle>There is a problem</ErrorSummaryTitle>
      <ErrorSummaryBody>
        <ErrorSummaryList>
          <ErrorSummaryItem href="#ex-1">
            The date your passport was issued must be in the past
          </ErrorSummaryItem>
          <ErrorSummaryItem href="#ex-2">
            Enter a postcode, like AA1 1AA
          </ErrorSummaryItem>
        </ErrorSummaryList>
      </ErrorSummaryBody>
    </ErrorSummary>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
import ErrorSummary from "@components/error-summary/error-summary.astro";
import ErrorSummaryTitle from "@components/error-summary/error-summary-title.astro";
import ErrorSummaryBody from "@components/error-summary/error-summary-body.astro";
import ErrorSummaryList from "@components/error-summary/error-summary-list.astro";
import ErrorSummaryItem from "@components/error-summary/error-summary-item.astro";
---

<ErrorSummary>
  <ErrorSummaryTitle>There is a problem</ErrorSummaryTitle>
  <ErrorSummaryBody>
    <ErrorSummaryList>
      <ErrorSummaryItem href="#ex-1">
        The date your passport was issued must be in the past
      </ErrorSummaryItem>
      <ErrorSummaryItem href="#ex-2">
        Enter a postcode, like AA1 1AA
      </ErrorSummaryItem>
    </ErrorSummaryList>
  </ErrorSummaryBody>
</ErrorSummary>`}
            lang="astro"
            theme="github-light"
          />
        </TabPanel>
        <TabPanel id="default-html" hidden>
          <Code
            code={`<div class="govuk-error-summary" data-module="govuk-error-summary">
  <div role="alert">
    <h2 class="govuk-error-summary__title">There is a problem</h2>
    <div class="govuk-error-summary__body">
      <ul class="govuk-list govuk-error-summary__list">
        <li>
          <a href="#ex-1">
            The date your passport was issued must be in the past
          </a>
        </li>
        <li>
          <a href="#ex-2">
            Enter a postcode, like AA1 1AA
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>`}
            lang="html"
            theme="github-light"
          />
        </TabPanel>
      </Tabs>
    </DetailsText>
  </Details>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
        <h2 class="govuk-heading-l">When to use this component</h2>
          <p class="govuk-body">Always show an error summary when there is a validation error, even if there’s only one.</p>
        <!-- GOVUK_GUIDANCE:END -->
</Layout>
