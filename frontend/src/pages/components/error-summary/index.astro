---
import Layout from "@layouts/ComponentsLayout.astro";
import ErrorSummary from "@components/error-summary/error-summary.astro";
import ErrorSummaryTitle from "@components/error-summary/error-summary-title.astro";
import ErrorSummaryBody from "@components/error-summary/error-summary-body.astro";
import ErrorSummaryList from "@components/error-summary/error-summary-list.astro";
import ErrorSummaryItem from "@components/error-summary/error-summary-item.astro";
---

<Layout>
  <h1 class="govuk-heading-xl">Error summary</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    The default error summary lists validation errors and links to each field.
  </p>
  <ErrorSummary>
    <ErrorSummaryTitle>There is a problem</ErrorSummaryTitle>
    <ErrorSummaryBody>
      <ErrorSummaryList>
        <ErrorSummaryItem href="#ex-1">
          The date your passport was issued must be in the past
        </ErrorSummaryItem>
        <ErrorSummaryItem href="#ex-2">
          Enter a postcode, like AA1 1AA
        </ErrorSummaryItem>
      </ErrorSummaryList>
    </ErrorSummaryBody>
  </ErrorSummary>

  <!-- GOVUK_GUIDANCE:START (auto-generated - edited content will be overwritten by scripts/update-component-guidance.mjs) -->
  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Always show an error summary when there is a validation error, even if
    there’s only one.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
</Layout>
