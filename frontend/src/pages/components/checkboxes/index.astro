---
import Layout from "@layouts/ComponentsLayout.astro";
import FormGroup from "@components/form-group/form-group.astro";
import Fieldset from "@components/fieldset/fieldset.astro";
import FieldsetLegend from "@components/fieldset/fieldset-legend.astro";
import Checkboxes from "@components/checkboxes/checkboxes.astro";
import CheckboxItem from "@components/checkboxes/checkbox-item.astro";
import CheckboxInput from "@components/checkboxes/checkbox-input.astro";
import CheckboxLabel from "@components/checkboxes/checkbox-label.astro";
import Tabs from "@components/tabs/tabs.astro";
import TabsList from "@components/tabs/tabs-list.astro";
import Tab from "@components/tabs/tab.astro";
import TabPanel from "@components/tabs/tab-panel.astro";
import Details from "@components/details/details.astro";
import DetailsSummary from "@components/details/details-summary.astro";
import DetailsText from "@components/details/details-text.astro";
import { Code } from "astro:components";
---

<Layout>
  <h1 class="govuk-heading-xl">Checkboxes</h1>

  <h2 class="govuk-heading-m">Default</h2>
  <p class="govuk-body">
    A default checkboxes group lets users select one or more options from a
    list.
  </p>
  <div class="component-container">
    <FormGroup>
      <Fieldset>
        <FieldsetLegend>What is your nationality?</FieldsetLegend>
        <Checkboxes>
          <CheckboxItem>
            <CheckboxInput
              id="nationality"
              name="nationality"
              value="british"
            />
            <CheckboxLabel for="nationality"> British </CheckboxLabel>
          </CheckboxItem>
          <CheckboxItem>
            <CheckboxInput
              id="nationality-2"
              name="nationality"
              value="irish"
            />
            <CheckboxLabel for="nationality-2"> Irish </CheckboxLabel>
          </CheckboxItem>
          <CheckboxItem>
            <CheckboxInput
              id="nationality-3"
              name="nationality"
              value="other"
            />
            <CheckboxLabel for="nationality-3">
              Citizen of another country
            </CheckboxLabel>
          </CheckboxItem>
        </Checkboxes>
      </Fieldset>
    </FormGroup>
  </div>
  <br />
  <Details>
    <DetailsSummary>Show code</DetailsSummary>
    <DetailsText>
      <Tabs>
        <TabsList>
          <Tab href="#default-astro" selected>Astro</Tab>
          <Tab href="#default-html">HTML</Tab>
        </TabsList>
        <TabPanel id="default-astro">
          <Code
            code={`---
