      <CheckboxItem>
        <CheckboxInput id="nationality-3" name="nationality" value="other" />
        <CheckboxLabel for="nationality-3">
          Citizen of another country
        </CheckboxLabel>
      </CheckboxItem>
    </Checkboxes>
  </Fieldset>
