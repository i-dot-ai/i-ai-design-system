  <h2 class="govuk-heading-l">When to use this component</h2>
  <p class="govuk-body">
    Use the checkboxes component when you need to help users:
  </p>
  <ul class="govuk-list govuk-list--bullet">
    <li>select multiple options from a list</li>
    <li>toggle a single option on or off</li>
  </ul>
  <h2 class="govuk-heading-l">When not to use this component</h2>
  <p class="govuk-body">
    Do not use the checkboxes component if users can only choose one option from
    a selection. In this case, use the <a
      class="govuk-link"
      href="https://design-system.service.gov.uk/components/radios/"
      >Radios component</a
    >.
  </p>
  <!-- GOVUK_GUIDANCE:END -->
