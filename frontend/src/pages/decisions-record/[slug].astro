---
import Layout from "@layouts/DecisionsRecordLayout.astro";
import Tag from "@components/tag/tag.astro";
import Example from "@components/docs/example.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const entries = await getCollection("decisions");
    return entries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const STATUS_TAG: Record<
    string,
    { colour: "blue" | "green" | "yellow" | "red"; label: string }
> = {
    proposal: { colour: "blue", label: "Proposal" },
    accepted: { colour: "green", label: "Accepted" },
    overridden: { colour: "yellow", label: "Overridden" },
    rejected: { colour: "red", label: "Rejected" },
};
const tag = STATUS_TAG[entry.data.status];

const heading =
    typeof entry.data.number === "number"
        ? `${String(entry.data.number).padStart(3, "0")} - ${entry.data.title}`
        : entry.data.title;
---

<Layout>
    <h1 class="govuk-heading-xl">{heading}</h1>
    {
        entry.data.dateProposed && (
            <p class="govuk-body">
                Date proposed: <strong>{entry.data.dateProposed}</strong>
            </p>
        )
    }
    <ul class="govuk-list">
        <li><Tag colour={tag.colour}>{tag.label}</Tag></li>
    </ul>
    <Content components={{ Example }} />
</Layout>
