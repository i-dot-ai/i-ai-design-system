---
import Layout from "@layouts/DecisionsRecordLayout.astro";
import { getCollection } from "astro:content";

// Fixed order the groups are shown in.
const GROUP_ORDER = ["Branding", "Design", "Technical", "Approach"] as const;

// The numbered decisions, ordered by their `number`. The
// `adapt-govuk-design-system` record is kept as further context and is not
// part of this list.
const decisions = (await getCollection("decisions"))
    .filter((entry) => entry.id !== "adapt-govuk-design-system")
    .sort((a, b) => a.data.number - b.data.number);

const grouped = GROUP_ORDER.map((group) => ({
    group,
    records: decisions.filter((d) => d.data.group === group),
})).filter((g) => g.records.length > 0);
---

<Layout>
    <h1 class="govuk-heading-xl">Design Decisions Record</h1>

    <p class="govuk-body">
        This is a record of the design decisions made in i.AI.
    </p>
</Layout>
