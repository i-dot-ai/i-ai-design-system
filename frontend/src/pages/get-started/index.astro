---
import Layout from "@layouts/GetStartedLayout.astro";
import Example from "@components/docs/example.astro";
import CodeBlock from "@components/docs/code-block.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("get-started", "index");
if (!entry) throw new Error("Missing get-started/index.mdx");
const { Content } = await render(entry);
---

<Layout>
    <h1 class="govuk-heading-xl">{entry.data.title}</h1>
    <Content components={{ Example, CodeBlock }} />
</Layout>
