---
import Layout from "@layouts/GetStartedLayout.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("guides", "adding-to-an-existing-project");
if (!entry) {
    throw new Error(
        "Missing content entry: guides/adding-to-an-existing-project",
    );
}
const { Content } = await render(entry);
---

<Layout>
    <h1 class="govuk-heading-xl">{entry.data.title}</h1>
    <Content />
</Layout>

<style>
    .i-ai-bold-numbers > li::marker {
        font-weight: bold;
        font-size: 1.2em;
    }
</style>
