---
import Layout from "@layouts/Layout.astro";
import Button from "@components/button/index.astro";
---

<Layout>
    <div class="govuk-main-wrapper app-masthead">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h1
                        class="govuk-heading-xl app-masthead__title"
                        style="color: #fff;"
                    >
                        An adapted GOV.UK Design System for i.AI web
                        applications
                    </h1>
                    <p class="govuk-body-l app-masthead__body">
                        Here is a collection of styles, patterns and components
                        to help speed up the process of building new products
                        and avoid repeating work.
                    </p>
                    <Button
                        variant="inverse"
                        href="/get-started"
                        class="govuk-button--start"
                    >
                        Get started
                        <svg
                            class="govuk-button__start-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="17.5"
                            height="19"
                            viewBox="0 0 33 40"
                            aria-hidden="true"
                            focusable="false"
                        >
                            <path
                                fill="currentColor"
                                d="M0 0h13l20 20-20 20H0l20-20z"></path>
                        </svg>
                    </Button>
                </div>
            </div>
        </div>
    </div>
    <div class="govuk-main-wrapper">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h2 class="govuk-heading-l">
                        How to use this design system
                    </h2>
                    <p class="govuk-body">
                        This is intended to speed up your work, and avoid
                        duplicated effort. It is a collection of resources to
                        help reduce solving for the same problems repeatedly
                        across our team.
                    </p>
                    <p class="govuk-body">
                        Therefore if something in here doesn't fit your needs,
                        or is missing, then please design for your problem and
                        we'll look into a way that we can add it in here.
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>
