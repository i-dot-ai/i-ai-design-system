---
import Layout from "@layouts/Layout.astro";
import Button from "@components/button/button.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("home", "index");
if (!entry) throw new Error("Missing home/index.mdx");
const { Content } = await render(entry);
---

<Layout>
    <div class="govuk-main-wrapper app-masthead">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h1 class="govuk-heading-xl app-masthead__title">
                        {entry.data.title}
                    </h1>
                    <p class="govuk-body-l app-masthead__body">
                        {entry.data.description}
                    </p>
                    <Button
                        variant="inverse"
                        href="/get-started"
                        class="govuk-button--start"
                    >
                        Get started
                        <svg
                            class="govuk-button__start-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="17.5"
                            height="19"
                            viewBox="0 0 33 40"
                            aria-hidden="true"
                            focusable="false"
                        >
                            <path
                                fill="currentColor"
                                d="M0 0h13l20 20-20 20H0l20-20z"></path>
                        </svg>
                    </Button>
                </div>
            </div>
        </div>
    </div>
    <div class="govuk-main-wrapper">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <Content />
                </div>
            </div>
        </div>
    </div>
</Layout>
